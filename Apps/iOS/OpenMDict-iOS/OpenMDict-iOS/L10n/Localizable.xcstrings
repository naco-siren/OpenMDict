    "presetUpdate.error.failed": {
      "comment": "Error when installing an updated preset dictionary failed; nothing was changed",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تثبيت التحديث. الإصدار السابق من القاموس لا يزال كما هو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update konnte nicht installiert werden. Die bisherige Version des Wörterbuchs ist weiterhin vorhanden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update couldn't be installed. The previous version of the dictionary is still in place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo instalar la actualización. La versión anterior del diccionario sigue en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour n'a pas pu être installée. La version précédente du dictionnaire est toujours en place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट इंस्टॉल नहीं हो सका। शब्दकोश का पिछला संस्करण अभी भी मौजूद है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートをインストールできませんでした。辞書は以前のバージョンのままです。"
