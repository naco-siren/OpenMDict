    "aiCoach.triage.localeMismatchSubtitle": {
      "comment": "Triage: subtitle framing the issue with region as prerequisite and language as variable. Arg 1 = localized region name, Arg 2 = localized language name.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تكون منطقة جهازك %1$@، لا تدعم Apple Intelligence لغة التطبيق الحالية (%2$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Region deines Geräts %1$@ ist, unterstützt Apple Intelligence die aktuelle App-Sprache (%2$@) nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "When your device region is %1$@, Apple Intelligence doesn't support your current app language (%2$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la región de tu dispositivo es %1$@, Apple Intelligence no admite el idioma actual de la app (%2$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque la région de votre appareil est %1$@, Apple Intelligence ne prend pas en charge la langue actuelle de l'app (%2$@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपके डिवाइस का क्षेत्र %1$@ है, तो Apple Intelligence ऐप की वर्तमान भाषा (%2$@) का समर्थन नहीं करता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの地域が「%1$@」の場合、Apple Intelligence は現在のアプリ言語「%2$@」に対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 지역이「%1$@」일 때, Apple Intelligence는 현재 앱 언어「%2$@」를 지원하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a região do seu dispositivo é %1$@, o Apple Intelligence não é compatível com o idioma atual do app (%2$@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда регион вашего устройства — %1$@, Apple Intelligence не поддерживает выбранный язык приложения (%2$@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли регіон вашого пристрою — %1$@, Apple Intelligence не підтримує поточну мову застосунку (%2$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的设备地区为【%1$@】时，Apple 智能不兼容您当前设置的应用语言【%2$@】。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的裝置地區為【%1$@】時，Apple 智能不相容您目前設置的應用程式語言【%2$@】。"
          }
        }
      }
    },
