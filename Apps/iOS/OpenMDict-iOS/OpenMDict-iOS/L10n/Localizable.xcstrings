        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez ajuster la taille du texte à l'aide des commandes de zoom dans la barre d'outils ci-dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऊपर टूलबार में ज़ूम नियंत्रणों का उपयोग करके टेक्स्ट का आकार समायोजित कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のツールバーのズームコントロールを使って文字サイズを調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위쪽 도구 모음의 확대/축소 컨트롤을 사용하여 텍스트 크기를 조정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ajustar o tamanho do texto usando os controles de zoom na barra de ferramentas acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете изменить размер текста с помощью элементов управления масштабом на панели инструментов выше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете змінити розмір тексту за допомогою елементів керування масштабом на панелі інструментів вище."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以使用上方工具栏中的缩放控件调整文字大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以使用上方工具列中的縮放控制項調整文字大小。"
          }
        }
      }
    },
