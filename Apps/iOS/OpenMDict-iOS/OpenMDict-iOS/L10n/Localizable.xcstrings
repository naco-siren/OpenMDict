        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もしかして…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혹시 이 단어를 찾으셨나요…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você quis dizer…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, вы имели в виду…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можливо, ви мали на увазі…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您是否在找…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您是否在找…"
          }
        }
      }
    },
