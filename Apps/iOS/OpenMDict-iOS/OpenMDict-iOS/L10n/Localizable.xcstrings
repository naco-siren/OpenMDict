    "troubleshoot.localConfirm2.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا الإجراء!\nستحتاج إلى إعداد هذا التطبيق من جديد واستيراد قواميسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DIES KANN NICHT RÜCKGÄNGIG GEMACHT WERDEN!\nDu musst die App erneut einrichten und deine Wörterbücher importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "THIS CANNOT BE UNDONE!\nYou will need to set up this app again and import your dictionaries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡ESTA ACCIÓN NO SE PUEDE DESHACER!\nNecesitarás configurar la app de nuevo e importar tus diccionarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CETTE ACTION EST IRRÉVERSIBLE !\nVous devrez reconfigurer l'app et importer vos dictionnaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पूर्ववत नहीं किया जा सकता!\nआपको इस ऐप को दोबारा सेट करना होगा और अपने शब्दकोश फिर से आयात करने होंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません！\nアプリを再設定し、辞書を再インポートする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없습니다!\n앱을 다시 설정하고 사전을 다시 가져와야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ESTA AÇÃO NÃO PODE SER DESFEITA!\nVocê precisará configurar o app novamente e importar seus dicionários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЭТО ДЕЙСТВИЕ НЕОБРАТИМО!\nВам потребуется заново настроить приложение и импортировать словари."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ЦЮ ДІЮ НЕ МОЖНА СКАСУВАТИ!\nВам потрібно буде заново налаштувати застосунок та імпортувати словники."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销！\n你需要重新设置此应用并导入词典。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作無法復原！\n你需要重新設定此應用程式並匯入辭典。"
          }
        }
      }
    },
    "troubleshoot.localConfirm2.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد تمامًا من أنك تريد مسح جميع البيانات المحلية؟!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BIST DU SICHER, DASS DU ALLE LOKALEN DATEN LÖSCHEN MÖCHTEST?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ARE YOU SURE YOU WANT TO CLEAR ALL LOCAL DATA?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿ESTÁS SEGURO DE QUE QUIERES BORRAR TODOS LOS DATOS LOCALES?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ÊTES-VOUS SÛR DE VOULOIR EFFACER TOUTES LES DONNÉES LOCALES ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई सभी स्थानीय डेटा मिटाना चाहते हैं?!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当にすべてのローカルデータを消去しますか！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말로 모든 로컬 데이터를 삭제하시겠습니까!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "TEM CERTEZA DE QUE DESEJA APAGAR TODOS OS DADOS LOCAIS?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВЫ УВЕРЕНЫ, ЧТО ХОТИТЕ УДАЛИТЬ ВСЕ ЛОКАЛЬНЫЕ ДАННЫЕ?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ВИ ВПЕВНЕНІ, ЩО ХОЧЕТЕ ВИДАЛИТИ ВСІ ЛОКАЛЬНІ ДАНІ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要清除所有本地数据吗！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要清除所有本機資料嗎！"
          }
        }
      }
    },
