    "syncChooser.description": {
      "comment": "Sync chooser: description text",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة القواميس والمجموعات والإشارات المرجعية وسجل البحث عبر جميع أجهزتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiere Wörterbücher, Gruppen, Lesezeichen und Suchverlauf auf all deinen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync your dictionaries, groups, bookmarks, and lookup history across all your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tus diccionarios, grupos, marcadores e historial de búsqueda en todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez vos dictionnaires, groupes, signets et historique de recherche sur tous vos appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सभी उपकरणों पर शब्दकोश, समूह, बुकमार्क और खोज इतिहास सिंक करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスで辞書、グループ、ブックマーク、検索履歴を同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 사전, 그룹, 북마크 및 검색 기록을 동기화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize seus dicionários, grupos, favoritos e histórico de consultas em todos os seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизируйте словари, группы, закладки и историю поиска на всех ваших устройствах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізуйте словники, групи, закладки та історію пошуку на всіх ваших пристроях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有设备间同步词典、分组、书签和查词历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有裝置間同步辭典、群組、書籤和查詞紀錄。"
          }
        }
      }
    },
    "syncChooser.descriptionWithData": {
      "comment": "Sync chooser: description when iCloud has existing data. %@ = inventory list e.g. '3 dictionaries, 2 groups, and 5 bookmarks'",
