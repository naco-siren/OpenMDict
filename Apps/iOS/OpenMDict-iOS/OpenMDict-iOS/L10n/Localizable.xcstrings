    "aiCoach.triage.solutionLanguageStep2": {
      "comment": "Triage: Solution 1 step 2 — the per-app language picker is system-provided and labeled 'Preferred Language' in iOS",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على «اللغة المفضلة» واختر لغة مدعومة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Bevorzugte Sprache“ und wähle eine unterstützte aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Tap Preferred Language and pick a supported one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Idioma preferido» y elige uno compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « Langue préférée » et choisissez-en une prise en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "«पसंदीदा भाषा» पर टैप करें और एक समर्थित भाषा चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「使用する言語」をタップし、対応する言語を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「선호하는 언어」를 탭하고 지원되는 언어를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em «Idioma preferido» e escolha um compatível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Предпочитаемый язык» и выберите поддерживаемый."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться «Пріоритетна мова» і виберіть підтримувану."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「首选语言」并选择一个支持的语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊「偏好語言」並選擇一個支援的語言。"
          }
        }
      }
    },
