          }
        }
      }
    },
    "tutorial.step.importAndResources.step4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه شاشة معلومات القاموس. يمكنك عرض البيانات الوصفية وعدد مرات البحث والإشارات المرجعية، وتخصيص اسم العرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist der Bildschirm mit den Wörterbuchinformationen. Du kannst Metadaten, Nachschlage- und Lesezeichenanzahl einsehen und den Anzeigenamen anpassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the dictionary info screen. You can see metadata, lookup and bookmark counts, and customize the display name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la pantalla de información del diccionario. Puedes ver los metadatos, el recuento de búsquedas y marcadores, y personalizar el nombre de visualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici l'écran d'informations du dictionnaire. Vous pouvez consulter les métadonnées, le nombre de recherches et de signets, et personnaliser le nom d'affichage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह शब्दकोश जानकारी स्क्रीन है। आप मेटाडेटा, खोज और बुकमार्क गिनती देख सकते हैं, और प्रदर्शन नाम अनुकूलित कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは辞書情報画面です。メタデータ、検索回数、ブックマーク数を確認し、表示名をカスタマイズできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 사전 정보 화면입니다. 메타데이터, 조회 수, 북마크 수를 확인하고 표시 이름을 사용자 지정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a tela de informações do dicionário. Você pode ver os metadados, contagens de consultas e favoritos, e personalizar o nome de exibição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это экран информации о словаре. Здесь можно просматривать метаданные, количество запросов и закладок, а также настраивать отображаемое имя."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це екран інформації про словник. Ви можете переглядати метадані, кількість пошуків і закладок та налаштовувати відображувану назву."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是词典信息页面。您可以查看元数据、查阅次数和书签数量，并自定义显示名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是詞典資訊頁面。您可以查看後設資料、查詢次數和書籤數量，並自訂顯示名稱。"
          }
        }
      }
    },
    "tutorial.step.importAndResources.step5": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر \"إدارة الموارد\" لإضافة ملفات تكميلية مثل MDD وCSS وJavaScript."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf \"Ressourcen verwalten\", um ergänzende Dateien wie MDD, CSS oder JavaScript hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Manage Resources\" to add supplementary files like MDD, CSS, or JavaScript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca \"Gestionar recursos\" para añadir archivos complementarios como MDD, CSS o JavaScript."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur \"Gérer les ressources\" pour ajouter des fichiers supplémentaires comme MDD, CSS ou JavaScript."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एमडीडी, सीएसएस या जावास्क्रिप्ट जैसी पूरक फ़ाइलें जोड़ने के लिए \"संसाधन प्रबंधित करें\" दबाएं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「リソースを管理」をタップして、MDD、CSS、JavaScript などの補助ファイルを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"리소스 관리\"를 탭하여 MDD, CSS 또는 JavaScript 같은 보조 파일을 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em \"Gerenciar Recursos\" para adicionar arquivos suplementares como MDD, CSS ou JavaScript."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите \"Управление ресурсами\", чтобы добавить дополнительные файлы, такие как MDD, CSS или JavaScript."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть \"Керування ресурсами\", щоб додати допоміжні файли, такі як MDD, CSS або JavaScript."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「管理资源」以添加 MDD、CSS 或 JavaScript 等补充文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按「管理資源」以新增 MDD、CSS 或 JavaScript 等補充檔案。"
          }
        }
      }
    },
    "tutorial.step.importAndResources.step6": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محرر الموارد يعرض جميع الملفات المرتبطة بهذا القاموس. تحتوي ملفات MDD على صور ومقاطع صوتية، بينما تُخصص CSS وJS مظهر المقالة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ressourcen-Editor zeigt alle Dateien, die mit diesem Wörterbuch verbunden sind. MDD-Dateien enthalten Bilder und Audio, während CSS und JS das Erscheinungsbild des Artikels anpassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The resource editor shows all files associated with this dictionary. MDD files contain images and audio, while CSS and JS customize the article appearance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor de recursos muestra todos los archivos asociados a este diccionario. Los archivos MDD contienen imágenes y audio, mientras que CSS y JS personalizan la apariencia del artículo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur de ressources affiche tous les fichiers associés à ce dictionnaire. Les fichiers MDD contiennent des images et de l'audio, tandis que CSS et JS personnalisent l'apparence de l'article."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संसाधन संपादक इस शब्दकोश से जुड़ी सभी फ़ाइलें दिखाता है। MDD फ़ाइलों में चित्र और ऑडियो होते हैं, जबकि CSS और JS लेख की उपस्थिति अनुकूलित करते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リソースエディタには、この辞書に関連するすべてのファイルが表示されます。MDD ファイルには画像や音声が含まれており、CSS と JS は記事の外観をカスタマイズします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리소스 편집기에는 이 사전과 관련된 모든 파일이 표시됩니다. MDD 파일에는 이미지와 오디오가 포함되어 있으며, CSS와 JS는 기사 모양을 사용자 지정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor de recursos exibe todos os arquivos associados a este dicionário. Arquivos MDD contêm imagens e áudio, enquanto CSS e JS personalizam a aparência do artigo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор ресурсов показывает все файлы, связанные с этим словарём. Файлы MDD содержат изображения и аудио, а CSS и JS настраивают внешний вид статей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор ресурсів показує всі файли, пов'язані з цим словником. Файли MDD містять зображення та аудіо, а CSS і JS налаштовують зовнішній вигляд статті."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资源编辑器显示与此词典关联的所有文件。MDD 文件包含图片和音频，而 CSS 和 JS 则自定义文章外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資源編輯器顯示與此詞典相關的所有檔案。MDD 檔案包含圖片和音訊，而 CSS 和 JS 則自訂文章外觀。"
          }
        }
      }
    },
    "tutorial.step.importAndResources.step7": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر \"إضافة ملف MDD\" لإرفاق أرشيف موارد. هكذا تُضيف صوت النطق والصور وغيرها من الوسائط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf \"MDD-Datei hinzufügen\", um ein Ressourcenarchiv anzuhängen. So fügst du Aussprache-Audio, Bilder oder andere Medien hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Add MDD File\" to attach a resource archive. This is how you add pronunciation audio, images, or other media."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca \"Añadir archivo MDD\" para adjuntar un archivo de recursos. Así es como añades audio de pronunciación, imágenes u otros medios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur \"Ajouter un fichier MDD\" pour joindre une archive de ressources. C'est ainsi que vous ajoutez de l'audio de prononciation, des images ou d'autres médias."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक संसाधन आर्काइव संलग्न करने के लिए \"एमडीडी फ़ाइल जोड़ें\" दबाएं। इस तरह आप उच्चारण ऑडियो, चित्र या अन्य मीडिया जोड़ते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「MDD ファイルを追加」をタップしてリソースアーカイブを添付します。これが発音音声、画像、その他のメディアを追加する方法です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"MDD 파일 추가\"를 탭하여 리소스 아카이브를 첨부하세요. 이것이 발음 오디오, 이미지 또는 기타 미디어를 추가하는 방법입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em \"Adicionar arquivo MDD\" para anexar um arquivo de recursos. É assim que você adiciona áudio de pronúncia, imagens ou outras mídias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите \"Добавить файл MDD\", чтобы прикрепить архив ресурсов. Так добавляется аудиопроизношение, изображения или другие медиафайлы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть \"Додати файл MDD\", щоб прикріпити архів ресурсів. Так додається аудіо вимови, зображення або інші медіафайли."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「添加 MDD 文件」以附加资源档案。这是添加发音音频、图片或其他媒体的方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按「新增 MDD 檔案」以附加資源封存檔。這是新增發音音訊、圖片或其他媒體的方式。"
          }
        }
      }
    },
    "tutorial.step.iPadProductivity.keyboardIntro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك لوحة مفاتيح متصلة! تحقق من القوائم في شريط القوائم أعلى الشاشة لاكتشاف جميع الاختصارات المتاحة. لنتدرب على بعضها:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast eine Tastatur angeschlossen! Schau dir die Menüs in der Menüleiste oben auf dem Bildschirm an, um alle verfügbaren Kurzbefehle zu entdecken. Lass uns ein paar üben:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have a keyboard connected! Check the menus in the menu bar at the top of the screen to discover all available shortcuts. Let's practice a few:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Tienes un teclado conectado! Revisa los menús en la barra de menús en la parte superior de la pantalla para descubrir todos los atajos disponibles. Practiquemos algunos:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez un clavier connecté ! Consultez les menus dans la barre de menus en haut de l'écran pour découvrir tous les raccourcis disponibles. Pratiquons-en quelques-uns :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने कीबोर्ड जोड़ा हुआ है! सभी उपलब्ध शॉर्टकट खोजने के लिए स्क्रीन के शीर्ष पर मेनू बार में मेनू देखें। कुछ अभ्यास करते हैं:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードが接続されています！画面上部のメニューバーにあるメニューを確認して、利用可能なすべてのショートカットを見つけましょう。いくつか練習してみましょう："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 연결되어 있습니다! 화면 상단 메뉴 막대의 메뉴를 확인하여 사용 가능한 모든 단축키를 알아보세요. 몇 가지 연습해 봅시다:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem um teclado conectado! Verifique os menus na barra de menus na parte superior da tela para descobrir todos os atalhos disponíveis. Vamos praticar alguns:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас подключена клавиатура! Проверьте меню в строке меню вверху экрана, чтобы узнать все доступные сочетания клавиш. Давайте попрактикуемся с несколькими:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви підключили клавіатуру! Перегляньте меню в рядку меню у верхній частині екрана, щоб дізнатися про всі доступні комбінації клавіш. Давайте потренуємось:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已连接键盘！请查看屏幕顶部菜单栏中的菜单，了解所有可用快捷键。我们来练习几个："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已連接鍵盤！請查看螢幕頂部選單列中的選單，了解所有可用的快速鍵。讓我們練習幾個："
          }
        }
      }
    },
    "tutorial.step.iPadProductivity.keyboardIntro.cmdKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك لوحة مفاتيح متصلة! اضغط مع الاستمرار على مفتاح ⌘ لرؤية جميع الاختصارات المتاحة دفعةً واحدة. لنتدرب على بعضها:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast eine Tastatur verbunden! Halte die ⌘-Taste gedrückt, um alle verfügbaren Kurzbefehle auf einen Blick zu sehen. Lass uns ein paar üben:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have a keyboard connected! Hold down the ⌘ key to see all available shortcuts at a glance. Let's practice a few:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Tienes un teclado conectado! Mantén pulsada la tecla ⌘ para ver todos los atajos disponibles de un vistazo. Practiquemos algunos:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clavier est connecté ! Maintenez la touche ⌘ enfoncée pour voir tous les raccourcis disponibles en un coup d'œil. Pratiquons-en quelques-uns :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका कीबोर्ड कनेक्ट है! सभी उपलब्ध शॉर्टकट एक नज़र में देखने के लिए ⌘ कुंजी दबाए रखें। आइए कुछ का अभ्यास करें:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードが接続されています！⌘ キーを長押しすると、利用可能なすべてのショートカットを一覧できます。いくつか練習してみましょう："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 연결되어 있습니다! ⌘ 키를 길게 눌러 사용 가능한 모든 단축키를 한눈에 확인하세요. 몇 가지 연습해 봅시다:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem um teclado conectado! Mantenha a tecla ⌘ pressionada para ver todos os atalhos disponíveis de uma vez. Vamos praticar alguns:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура подключена! Удерживайте клавишу ⌘, чтобы увидеть все доступные сочетания клавиш. Давайте потренируемся:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіатуру підключено! Утримуйте клавішу ⌘, щоб побачити всі доступні скорочення. Давайте потренуємося:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已连接键盘！按住 ⌘ 键可一览所有可用快捷键。我们来练习几个："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已連接鍵盤！按住 ⌘ 鍵可一覽所有可用快捷鍵。我們來練習幾個："
          }
        }
      }
    },
    "tutorial.step.iPadProductivity.noKeyboard": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند توصيل لوحة مفاتيح مادية، تحقق من القوائم في شريط القوائم أعلى الشاشة لاكتشاف جميع اختصارات لوحة المفاتيح المتاحة — من التكبير والبحث في النصوص إلى تبديل التخطيطات وإدارة النوافذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine physische Tastatur anschließt, schau dir die Menüs in der Menüleiste oben auf dem Bildschirm an, um alle verfügbaren Tastaturkurzbefehle zu entdecken — vom Zoomen und Textsuchen bis zum Wechseln von Layouts und Verwalten von Fenstern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you connect a physical keyboard, check the menus in the menu bar at the top of the screen to discover all available keyboard shortcuts — from zooming and finding text to switching layouts and managing windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando conectes un teclado físico, revisa los menús en la barra de menús en la parte superior de la pantalla para descubrir todos los atajos de teclado disponibles — desde zoom y búsqueda de texto hasta cambio de diseño y gestión de ventanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous connectez un clavier physique, consultez les menus dans la barre de menus en haut de l'écran pour découvrir tous les raccourcis clavier disponibles — du zoom et de la recherche de texte au changement de mise en page et à la gestion des fenêtres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप भौतिक कीबोर्ड जोड़ते हैं, तो सभी उपलब्ध कीबोर्ड शॉर्टकट खोजने के लिए स्क्रीन के शीर्ष पर मेनू बार में मेनू देखें — ज़ूम करने और टेक्स्ट खोजने से लेकर लेआउट बदलने और विंडो प्रबंधित करने तक।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物理キーボードを接続したら、画面上部のメニューバーにあるメニューを確認して、利用可能なすべてのキーボードショートカットを見つけましょう — ズームやテキスト検索から、レイアウトの切り替えやウィンドウ管理まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 키보드를 연결하면 화면 상단 메뉴 막대의 메뉴를 확인하여 사용 가능한 모든 키보드 단축키를 알아보세요 — 확대/축소 및 텍스트 찾기부터 레이아웃 전환 및 창 관리까지."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você conectar um teclado físico, verifique os menus na barra de menus na parte superior da tela para descobrir todos os atalhos de teclado disponíveis — de zoom e localização de texto a mudança de layout e gerenciamento de janelas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы подключите физическую клавиатуру, проверьте меню в строке меню вверху экрана, чтобы узнать все доступные сочетания клавиш — от масштабирования и поиска текста до переключения макетов и управления окнами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви підключите фізичну клавіатуру, перегляньте меню в рядку меню у верхній частині екрана, щоб дізнатися про всі доступні комбінації клавіш — від масштабування та пошуку тексту до перемикання макетів і керування вікнами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您连接实体键盘时，请查看屏幕顶部菜单栏中的菜单，了解所有可用的键盘快捷键——从缩放和查找文本，到切换布局和管理窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您連接實體鍵盤時，請查看螢幕頂部選單列中的選單，了解所有可用的鍵盤快速鍵——從縮放和尋找文字，到切換版面配置和管理視窗。"
          }
        }
      }
    },
    "tutorial.step.iPadProductivity.noKeyboard.cmdKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند توصيل لوحة مفاتيح فعلية، اضغط مع الاستمرار على مفتاح ⌘ لعرض ورقة غش بجميع اختصارات لوحة المفاتيح المتاحة — من التكبير والبحث في النص إلى تبديل التخطيطات وإدارة النوافذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald du eine physische Tastatur anschließt, halte die ⌘-Taste gedrückt, um eine Übersicht aller verfügbaren Kurzbefehle anzuzeigen — vom Zoomen und Suchen über das Wechseln des Layouts bis hin zur Fensterverwaltung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you connect a physical keyboard, hold down the ⌘ key to reveal a cheat sheet of all available keyboard shortcuts — from zooming and finding text to switching layouts and managing windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando conectes un teclado físico, mantén pulsada la tecla ⌘ para mostrar una hoja de referencia con todos los atajos de teclado disponibles: desde zoom y búsqueda de texto hasta cambio de diseño y gestión de ventanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous connectez un clavier physique, maintenez la touche ⌘ enfoncée pour afficher un aide-mémoire de tous les raccourcis clavier disponibles — du zoom et de la recherche de texte au changement de disposition et à la gestion des fenêtres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप कोई भौतिक कीबोर्ड कनेक्ट करें, तो सभी उपलब्ध कीबोर्ड शॉर्टकट की चीट शीट देखने के लिए ⌘ कुंजी दबाए रखें — ज़ूमिंग और टेक्स्ट खोजने से लेकर लेआउट बदलने और विंडो प्रबंधन तक।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物理キーボードを接続したら、⌘ キーを長押しすることで、利用可能なすべてのキーボードショートカットの一覧を表示できます。ズームやテキスト検索から、レイアウト切り替えやウィンドウ管理まで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물리적 키보드를 연결하면 ⌘ 키를 길게 눌러 모든 키보드 단축키 치트 시트를 볼 수 있습니다. 확대/축소 및 텍스트 찾기부터 레이아웃 전환 및 창 관리까지 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao conectar um teclado físico, mantenha a tecla ⌘ pressionada para exibir uma folha de referência com todos os atalhos de teclado disponíveis — desde zoom e busca de texto até troca de layout e gerenciamento de janelas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключив физическую клавиатуру, удержите клавишу ⌘, чтобы вызвать шпаргалку со всеми доступными сочетаниями клавиш — от масштабирования и поиска текста до переключения раскладок и управления окнами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключивши фізичну клавіатуру, утримуйте клавішу ⌘, щоб відобразити шпаргалку з усіма доступними скороченнями — від масштабування та пошуку тексту до перемикання розкладок і керування вікнами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接实体键盘后，按住 ⌘ 键即可显示所有可用键盘快捷键的速查表——从缩放和查找文字，到切换布局和管理窗口，一应俱全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接實體鍵盤後，按住 ⌘ 鍵即可顯示所有可用鍵盤快捷鍵的速查表——從縮放和尋找文字，到切換版面和管理視窗，一應俱全。"
          }
        }
      }
    },
    "tutorial.step.iPadProductivity.quizDict": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ممتاز! تحدي إضافي: الاختصارات مفيدة بشكل خاص لاختيار قاموس أو مجموعة محددة. ابحث عن اختصار \"القاموس 1\" واضغط عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgezeichnet! Bonusaufgabe: Kurzbefehle sind besonders nützlich, um ein bestimmtes Wörterbuch oder eine Gruppe auszuwählen. Finde und drücke den Kurzbefehl für \"Wörterbuch 1\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excellent! Bonus challenge: shortcuts are particularly useful for selecting a specific dictionary or group. Find and press the shortcut for \"Dictionary 1\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Excelente! Desafío adicional: los atajos son especialmente útiles para seleccionar un diccionario o grupo específico. Encuentra y presiona el atajo para \"Diccionario 1\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Excellent ! Défi bonus : les raccourcis sont particulièrement utiles pour sélectionner un dictionnaire ou un groupe spécifique. Trouvez et appuyez sur le raccourci pour \"Dictionnaire 1\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्कृष्ट! बोनस चुनौती: विशिष्ट शब्दकोश या समूह चुनने के लिए शॉर्टकट विशेष रूप से उपयोगी होते हैं। \"शब्दकोश 1\" का शॉर्टकट ढूंढें और दबाएं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素晴らしい！ボーナスチャレンジ：特定の辞書やグループを選択する場合、ショートカットが特に役立ちます。「辞書 1」のショートカットを見つけて押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훌륭합니다! 보너스 도전: 단축키는 특정 사전이나 그룹을 선택할 때 특히 유용합니다. \"사전 1\"의 단축키를 찾아 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excelente! Desafio bônus: os atalhos são particularmente úteis para selecionar um dicionário ou grupo específico. Encontre e pressione o atalho para \"Dicionário 1\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превосходно! Дополнительное задание: сочетания клавиш особенно полезны для выбора конкретного словаря или группы. Найдите и нажмите сочетание клавиш для \"Словарь 1\"."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чудово! Додаткове завдання: комбінації клавіш особливо корисні для вибору певного словника або групи. Знайдіть і натисніть комбінацію клавіш для \"Словник 1\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "极好！附加挑战：快捷键对于选择特定词典或词典组特别有用。找到并按下「词典 1」的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太棒了！附加挑戰：快速鍵對於選擇特定詞典或詞典組特別實用。找到並按下「詞典 1」的快速鍵。"
          }
        }
      }
    },
    "tutorial.step.iPadProductivity.quizGrid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحسنت! تتيح لك الاختصارات التبديل السريع بين تخطيطات مختلفة على iPad. الآن ابحث عن اختصار \"تخطيط شبكي\" واضغط عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut gemacht! Kurzbefehle ermöglichen es dir, auf dem iPad schnell zwischen verschiedenen Layouts zu wechseln. Finde und drücke nun den Kurzbefehl für \"Gitterlayout\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Well done! Shortcuts let you quickly switch between different layouts on iPad. Now find and press the shortcut for \"Grid Layout\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bien hecho! Los atajos te permiten cambiar rápidamente entre diferentes diseños en el iPad. Ahora encuentra y presiona el atajo para \"Diseño de cuadrícula\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien joué ! Les raccourcis vous permettent de basculer rapidement entre différentes mises en page sur iPad. Trouvez maintenant et appuyez sur le raccourci pour \"Mise en page grille\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शाबाश! शॉर्टकट आपको iPad पर विभिन्न लेआउट के बीच तेज़ी से स्विच करने देते हैं। अब \"ग्रिड लेआउट\" का शॉर्टकट ढूंढें और दबाएं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よくできました！ショートカットを使うと iPad でさまざまなレイアウトをすばやく切り替えられます。今度は「グリッドレイアウト」のショートカットを見つけて押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘했습니다! 단축키를 사용하면 iPad에서 다른 레이아웃으로 빠르게 전환할 수 있습니다. 이제 \"격자 레이아웃\"의 단축키를 찾아 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muito bem! Os atalhos permitem alternar rapidamente entre diferentes layouts no iPad. Agora encontre e pressione o atalho para \"Layout de grade\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отлично! Сочетания клавиш позволяют быстро переключаться между разными макетами на iPad. Теперь найдите и нажмите сочетание клавиш для \"Сетчатый макет\"."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чудово! Комбінації клавіш дозволяють швидко перемикатися між різними макетами на iPad. Тепер знайдіть і натисніть комбінацію клавіш для \"Сітчастий макет\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很好！快捷键让您在 iPad 上快速切换不同布局。现在找到并按下「网格布局」的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做得好！快速鍵讓您在 iPad 上快速切換不同版面配置。現在找到並按下「格狀版面配置」的快速鍵。"
          }
        }
      }
    },
    "tutorial.step.iPadProductivity.quizZoom": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن اختصار \"تكبير\" في شريط القوائم، ثم اضغط عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde den Tastenkurzbefehl für \"Vergrößern\" in der Menüleiste und drücke ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the shortcut for \"Zoom In\" in the menu bar, then press it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra el atajo para \"Ampliar\" en la barra de menús y presiónalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez le raccourci pour \"Zoom avant\" dans la barre de menus, puis appuyez dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेनू बार में \"ज़ूम इन\" का शॉर्टकट ढूंढें, फिर उसे दबाएं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーで「拡大」のショートカットを見つけて押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 \"확대\"의 단축키를 찾아 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre o atalho para \"Ampliar\" na barra de menus e pressione-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите сочетание клавиш для \"Увеличить\" в строке меню и нажмите его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдіть комбінацію клавіш для \"Збільшити\" в рядку меню та натисніть її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏中找到「放大」的快捷键，然后按下它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列中找到「放大」的快速鍵，然後按下它。"
          }
        }
      }
    },
    "tutorial.step.iPadProductivity.quizZoom.cmdKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مع الاستمرار على ⌘ لفتح ورقة الغش، ابحث عن اختصار التكبير ثم اضغطه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ⌘ gedrückt, um das Spickzettel zu öffnen, finde den Kurzbefehl für Vergrößern und drücke ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold ⌘ to open the cheat sheet, find the shortcut for \"Zoom In\", then press it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada ⌘ para abrir la hoja de referencia, encuentra el atajo para Acercar y presiónalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘ pour ouvrir l'aide-mémoire, trouvez le raccourci pour Zoom avant, puis appuyez dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चीट शीट खोलने के लिए ⌘ दबाए रखें, ज़ूम इन का शॉर्टकट खोजें, फिर उसे दबाएं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ を長押ししてチートシートを開き、拡大のショートカットを見つけて押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ 를 길게 눌러 치트 시트를 열고, 확대 단축키를 찾아 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⌘ pressionado para abrir a folha de referência, encontre o atalho para Ampliar e pressione-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите ⌘, чтобы открыть шпаргалку, найдите ярлык для увеличения масштаба и нажмите его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте ⌘, щоб відкрити шпаргалку, знайдіть скорочення для збільшення та натисніть його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 打开快捷键速查表，找到放大的快捷键，然后按下它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 打開快捷鍵速查表，找到放大的快捷鍵，然後按下它。"
          }
        }
      }
    },
    "tutorial.step.iPadProductivity.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر هذا الزر لفتح المقالة الحالية في نافذة جديدة. يمكنك أيضاً الضغط طويلاً على أي نتيجة بحث للعثور على نفس الخيار — رائع لمقارنة التعريفات جنباً إلى جنب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf diese Schaltfläche, um den aktuellen Artikel in einem neuen Fenster zu öffnen. Du kannst auch jedes Suchergebnis lang drücken, um dieselbe Option zu finden — ideal zum Vergleichen von Definitionen nebeneinander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap this button to open the current article in a new window. You can also long-press any search result to find the same option — great for comparing definitions side by side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca este botón para abrir el artículo actual en una nueva ventana. También puedes mantener pulsado cualquier resultado de búsqueda para encontrar la misma opción — ideal para comparar definiciones en paralelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ce bouton pour ouvrir l'article actuel dans une nouvelle fenêtre. Vous pouvez également appuyer longuement sur n'importe quel résultat de recherche pour trouver la même option — idéal pour comparer des définitions côte à côte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान लेख को एक नई विंडो में खोलने के लिए इस बटन को दबाएं। आप किसी भी खोज परिणाम को लंबे समय तक दबाकर वही विकल्प पा सकते हैं — परिभाषाओं को नाल जानच करने के लिए उपयुक्त।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボタンをタップして、現在の記事を新しいウィンドウで開きます。検索結果を長押しして同じオプションを見つけることもできます — 定義を並べて比較するのに便利です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버튼을 탭하여 현재 기사를 새 창에서 엽니다. 검색 결과를 길게 눌러 같은 옵션을 찾을 수도 있습니다 — 정의를 나란히 비교하기에 좋습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque neste botão para abrir o artigo atual em uma nova janela. Você também pode pressionar e segurar qualquer resultado de pesquisa para encontrar a mesma opção — ótimo para comparar definições lado a lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите эту кнопку, чтобы открыть текущую статью в новом окне. Вы также можете долго нажать на любой результат поиска, чтобы найти ту же опцию — отлично подходит для сравнения определений рядом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть цю кнопку, щоб відкрити поточну статтю в новому вікні. Ви також можете довго натискати будь-який результат пошуку, щоб знайти той самий параметр — чудово підходить для порівняння визначень поруч."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击此按钮，在新窗口中打开当前文章。您也可以长按任意搜索结果以找到相同选项——非常适合并排比较词义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按此按鈕，在新視窗中開啟目前的文章。您也可以長按任何搜尋結果以找到相同選項——非常適合並排比較詞義。"
          }
        }
      }
    },
    "tutorial.step.jumpSearch.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء قراءة مقالة، يمكنك البحث عن أي كلمة بتحديدها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Lesen eines Eintrags können Sie jedes Wort nachschlagen, indem Sie es auswählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When reading an article, you can look up any word by selecting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras lees un artículo, puedes buscar cualquier palabra seleccionándola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors de la lecture d'un article, vous pouvez rechercher n'importe quel mot en le sélectionnant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई लेख पढ़ते समय, आप किसी भी शब्द को चुनकर उसे खोज सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事を読んでいるとき、任意の単語を選択して調べることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기사를 읽는 동안 단어를 선택하여 찾아볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao ler um artigo, você pode pesquisar qualquer palavra selecionando-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При чтении статьи вы можете найти любое слово, выделив его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час читання статті ви можете знайти будь-яке слово, виділивши його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读文章时，您可以通过选中任意单词来查找它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閱讀文章時，您可以透過選取任意單字來查找它。"
          }
        }
      }
    },
    "tutorial.step.jumpSearch.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولاً على كلمة لتحديدها، ثم اختر \"البحث السريع\" من القائمة السياقية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie ein Wort gedrückt, um es auszuwählen, und wählen Sie dann \"Schnellsuche\" aus dem Kontextmenü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press on a word to select it, then choose \"Jump Search\" from the context menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionada una palabra para seleccionarla y luego elige \"Búsqueda rápida\" en el menú contextual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur un mot pour le sélectionner, puis choisissez \"Recherche rapide\" dans le menu contextuel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी शब्द को लंबे समय तक दबाकर उसे चुनें, फिर संदर्भ मेनू से \"जंप सर्च\" चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を長押しして選択し、コンテキストメニューから「ジャンプ検索」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 길게 눌러 선택한 다음 상황에 맞는 메뉴에서 \"바로 검색\"을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione e segure uma palavra para selecioná-la, depois escolha \"Busca rápida\" no menu de contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте слово, чтобы выделить его, затем выберите «Быстрый поиск» в контекстном меню."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і утримуйте слово, щоб виділити його, потім виберіть «Швидкий пошук» у контекстному меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按某个单词以选中它，然后从上下文菜单中选择「跳转搜索」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按某個單字以選取它，然後從上下文選單中選擇「跳轉搜尋」。"
          }
        }
      }
    },
    "tutorial.step.jumpSearch.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبحث \"البحث السريع\" عن الكلمة المحددة في جميع قواميسك — كأنك تمتلك قاموساً داخل قاموس!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schnellsuche sucht das ausgewählte Wort in all Ihren Wörterbüchern — wie ein Wörterbuch im Wörterbuch!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump Search will look up the selected word across all your dictionaries — it's like having a dictionary within a dictionary!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda rápida buscará la palabra seleccionada en todos tus diccionarios — ¡como tener un diccionario dentro de un diccionario!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche rapide cherchera le mot sélectionné dans tous vos dictionnaires — comme avoir un dictionnaire dans un dictionnaire !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जंप सर्च चयनित शब्द को आपके सभी शब्दकोशों में खोजेगा — जैसे शब्दकोश के अंदर एक शब्दकोश!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャンプ検索は選択した単語をすべての辞書から検索します。まるで辞書の中の辞書です！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 검색은 선택한 단어를 모든 사전에서 찾아줍니다. 사전 속의 사전과 같습니다!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca rápida procurará a palavra selecionada em todos os seus dicionários — é como ter um dicionário dentro de um dicionário!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрый поиск найдёт выбранное слово во всех ваших словарях — как словарь внутри словаря!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидкий пошук знайде вибране слово у всіх ваших словниках — як словник у словнику!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳转搜索将在您所有词典中查找所选单词——就像词典中的词典！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跳轉搜尋將在您所有詞典中查找所選單字——就像詞典中的詞典！"
          }
        }
      }
    },
    "tutorial.step.lookupBasics.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل أن تكتب أي شيء، تعرض قائمة الكلمات محتوى الحافظة وسجل البحث الأخير للوصول السريع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor Sie etwas eingeben, zeigt die Wortliste Ihren Zwischenablageinhalt und den letzten Suchverlauf für den schnellen Zugriff an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you type anything, the word list shows your clipboard content and recent lookup history for quick access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de escribir algo, la lista de palabras muestra el contenido del portapapeles y el historial de búsquedas recientes para un acceso rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de saisir quoi que ce soit, la liste de mots affiche le contenu de votre presse-papiers et l'historique de recherche récent pour un accès rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी टाइप करने से पहले, शब्द सूची आपके क्लिपबोर्ड की सामग्री और हाल की खोज इतिहास को त्वरित पहुँच के लिए दिखाती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も入力する前に、単語リストにはクリップボードの内容と最近の検索履歴が表示され、素早くアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 입력하기 전에, 단어 목록에는 클립보드 내용과 최근 검색 기록이 표시되어 빠르게 접근할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de digitar qualquer coisa, a lista de palavras mostra o conteúdo da área de transferência e o histórico de pesquisas recentes para acesso rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы ничего не ввели, список слов отображает содержимое буфера обмена и недавнюю историю поиска для быстрого доступа."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки ви нічого не ввели, список слів відображає вміст буфера обміну та нещодавню історію пошуку для швидкого доступу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您输入任何内容之前，单词列表会显示剪贴板内容和最近的查询历史，方便快速访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您輸入任何內容之前，單字列表會顯示剪貼板內容和最近的查詢歷史，方便快速存取。"
          }
        }
      }
    },
    "tutorial.step.lookupBasics.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء الكتابة، ستظهر النتائج في الوقت الفعلي. اضغط على أي نتيجة لعرض المقالات الكاملة من جميع قواميسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während Sie tippen, sehen Sie die Ergebnisse in Echtzeit. Tippen Sie auf ein Ergebnis, um vollständige Artikel aus allen Ihren Wörterbüchern anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As you type, you'll see the results in real time. Tap any result to view full articles from all your dictionaries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A medida que escribe, verá los resultados en tiempo real. Toque cualquier resultado para ver los artículos completos de todos sus diccionarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au fur et à mesure que vous tapez, vous verrez les résultats en temps réel. Appuyez sur n'importe quel résultat pour afficher les articles complets de tous vos dictionnaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे-जैसे आप टाइप करते हैं, परिणाम रियल टाइम में दिखाई देंगे। अपने सभी शब्दकोशों के पूरे लेख देखने के लिए किसी भी परिणाम पर टैप करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力するにつれて、結果がリアルタイムで表示されます。任意の結果をタップすると、すべての辞書の全文記事を表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하는 동안 실시간으로 결과가 표시됩니다. 결과를 탭하면 모든 사전의 전체 항목을 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conforme você digita, verá os resultados em tempo real. Toque em qualquer resultado para ver os artigos completos de todos os seus dicionários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По мере ввода вы будете видеть результаты в реальном времени. Нажмите на любой результат, чтобы просмотреть полные статьи из всех ваших словарей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час введення ви бачитимете результати в реальному часі. Торкніться будь-якого результату, щоб переглянути повні статті з усіх ваших словників."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您输入时，您将实时看到结果。点击任意结果可查看所有词典的完整词条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您輸入時，您將即時看到結果。點選任意結果可查看所有詞典的完整詞條。"
          }
        }
      }
    },
    "tutorial.step.lookupBasics.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجد OpenMDict تلقائيًا الأشكال المرتبطة — لذا فإن البحث عن \"running\" يجد أيضًا \"run\". رائع للتصريفات والاشتقاقات!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict findet automatisch verwandte Formen — die Suche nach \"running\" findet also auch \"run\". Perfekt für Konjugationen und Flexionen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict automatically finds related forms — so searching for \"running\" also finds \"run\". Great for conjugations and inflections!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict encuentra automáticamente formas relacionadas — así que buscar \"running\" también encuentra \"run\". ¡Ideal para conjugaciones e inflexiones!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict trouve automatiquement les formes associées — ainsi, chercher \"running\" trouve aussi \"run\". Idéal pour les conjugaisons et les flexions !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict स्वचालित रूप से संबंधित रूप खोजता है — इसलिए \"running\" खोजने पर \"run\" भी मिलता है। क्रिया रूपों और विभक्तियों के लिए बहुत उपयोगी!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict は関連する形式を自動的に検索します。「running」を検索すると「run」も見つかります。活用形や語形変化に最適です！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict는 관련 형태를 자동으로 찾아줍니다. 따라서 \"running\"을 검색하면 \"run\"도 찾을 수 있습니다. 활용형과 어형 변화에 매우 유용합니다!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OpenMDict encontra automaticamente formas relacionadas — então buscar \"running\" também encontra \"run\". Ótimo para conjugações e flexões!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict автоматически находит связанные формы — поиск «running» также найдёт «run». Отлично подходит для спряжений и словоизменений!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict автоматично знаходить пов'язані форми — тому пошук «running» також знайде «run». Чудово підходить для відмінювань та словозміни!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict 会自动查找相关形式——因此搜索\"running\"也能找到\"run\"。非常适合动词变位和词形变化！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict 會自動尋找相關形式——因此搜尋「running」也能找到「run」。非常適合動詞變位和詞形變化！"
          }
        }
      }
    },
    "tutorial.step.lookupBasics.step4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان استعلامك يحتوي على خطأ إملائي أو عدد قليل جدًا من التطابقات المباشرة، تظهر اقتراحات لمساعدتك في العثور على الكلمة الصحيحة من خلال المطابقة التقريبية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Ihre Suchanfrage einen Tippfehler enthält oder zu wenige direkte Treffer liefert, erscheinen Vorschläge, die Ihnen helfen, das richtige Wort durch unscharfe Suche zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your query has a typo or too few direct matches, suggestions appear to help you find the right word through fuzzy matching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si su consulta tiene un error tipográfico o muy pocas coincidencias directas, aparecen sugerencias para ayudarle a encontrar la palabra correcta mediante coincidencia aproximada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre recherche contient une faute de frappe ou trop peu de correspondances directes, des suggestions apparaissent pour vous aider à trouver le bon mot grâce à la recherche approximative."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपकी खोज में टाइपो है या सीधे मिलान बहुत कम हैं, तो फ़ज़ी मिलान के माध्यम से सही शब्द खोजने में मदद के लिए सुझाव दिखाई देते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クエリにタイプミスがある場合や直接一致する結果が少ない場合、あいまい検索によって正しい単語を見つけるための候補が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색어에 오타가 있거나 직접 일치 결과가 너무 적으면, 퍼지 매칭을 통해 올바른 단어를 찾을 수 있도록 제안이 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sua pesquisa tiver um erro de digitação ou poucas correspondências diretas, sugestões aparecem para ajudá-lo a encontrar a palavra certa por meio de correspondência aproximada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если в вашем запросе есть опечатка или слишком мало прямых совпадений, появятся подсказки, которые помогут найти нужное слово с помощью нечёткого поиска."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо у вашому запиті є помилка друку або занадто мало прямих збігів, з'являться підказки, які допоможуть знайти потрібне слово за допомогою нечіткого пошуку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的查询有拼写错误或直接匹配结果太少，系统会通过模糊匹配显示建议，帮助您找到正确的单词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的查詢有拼寫錯誤或直接匹配結果太少，系統會透過模糊比對顯示建議，幫助您找到正確的單字。"
          }
        }
      }
    },
    "tutorial.step.popupLookup.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتيح لك ميزة البحث المنبثق البحث عن الكلمات من أي تطبيق — Safari والبريد والملاحظات وغيرها — دون مغادرة الصفحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop-up-Suche ermöglicht es Ihnen, Wörter aus jeder App — Safari, Mail, Notizen und mehr — nachzuschlagen, ohne die Seite zu verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop-up Lookup lets you look up words from any app — Safari, Mail, Notes, and more — without leaving the page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda emergente le permite buscar palabras desde cualquier aplicación — Safari, Mail, Notas y más — sin salir de la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche contextuelle vous permet de rechercher des mots depuis n'importe quelle application — Safari, Mail, Notes et plus encore — sans quitter la page."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉप-अप लुकअप आपको किसी भी ऐप — Safari, Mail, Notes और अन्य — से पेज छोड़े बिना शब्द खोजने देता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップアップ検索を使うと、Safari、メール、メモなど、どのアプリからでもページを離れることなく単語を調べることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팝업 검색 기능을 사용하면 Safari, 메일, 메모 등 어떤 앱에서도 페이지를 벗어나지 않고 단어를 검색할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa pop-up permite que você pesquise palavras em qualquer aplicativo — Safari, Mail, Notas e muito mais — sem sair da página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всплывающий поиск позволяет искать слова в любом приложении — Safari, Почта, Заметки и других — не покидая страницу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спливаючий пошук дозволяє шукати слова в будь-якому додатку — Safari, Пошта, Нотатки тощо — не покидаючи сторінку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹出查词功能让您无需离开当前页面，就能从任何应用——Safari、邮件、备忘录等——查询单词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈出查詞功能讓您無需離開目前頁面，就能從任何應用程式——Safari、郵件、備忘錄等——查詢單字。"
          }
        }
      }
    },
    "tutorial.step.popupLookup.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جربها الآن! اضغط مطولاً على كلمة غامقة أدناه لتحديدها، ثم اضغط على \"مشاركة\"، اضغط على \"عرض المزيد\" واختر:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probieren Sie es jetzt aus! Halten Sie ein fett gedrucktes Wort unten gedrückt, um es auszuwählen, tippen Sie dann auf \"Teilen\", tippen Sie auf \"Mehr anzeigen\" und wählen Sie:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try it now! Long-press a bold word below to select it, then tap \"Share\", tap \"View More\", and choose:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Pruébelo ahora! Mantenga presionada una palabra en negrita a continuación para seleccionarla, luego toque \"Compartir\", toque \"Ver más\" y elija:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez maintenant ! Appuyez longuement sur un mot en gras ci-dessous pour le sélectionner, puis appuyez sur \"Partager\", appuyez sur \"Afficher plus\" et choisissez :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी आज़माएं! नीचे किसी बोल्ड शब्द को लंबे समय तक दबाएं, फिर \"शेयर\" पर टैप करें, \"अधिक देखें\" पर टैप करें और चुनें:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ試してみましょう！下の太字の単語を長押しして選択し、「共有」をタップして「詳細を表示」をタップし、選んでください："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 해보세요! 아래의 굵은 단어를 길게 눌러 선택한 다음 \"공유\"를 탭하고 \"더 보기\"를 탭한 후 선택하세요:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente agora! Pressione e segure uma palavra em negrito abaixo para selecioná-la, toque em \"Compartilhar\", toque em \"Ver mais\" e escolha:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте прямо сейчас! Удерживайте выделенное жирным слово ниже, затем нажмите «Поделиться», потом «Показать ещё» и выберите:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте зараз! Утримуйте виділене жирним слово нижче, щоб вибрати його, потім натисніть «Поділитися», натисніть «Показати більше» і виберіть:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在试试吧！长按下方粗体单词以选中它，然后点击「共享」，再点击「查看更多」，并选择："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在試試看！長按下方粗體單字以選取它，然後點選「分享」，再點選「查看更多」，並選擇："
          }
        }
      }
    },
    "tutorial.step.popupLookup.step2.legacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جربها الآن! اضغط مطولاً على كلمة غامقة أدناه لتحديدها، ثم اضغط على \"مشاركة\" واختر:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probieren Sie es jetzt aus! Halten Sie ein fett gedrucktes Wort unten gedrückt, um es auszuwählen, tippen Sie dann auf \"Teilen\" und wählen Sie:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try it now! Long-press a bold word below to select it, then tap \"Share\" and choose:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Pruébelo ahora! Mantenga presionada una palabra en negrita a continuación para seleccionarla, luego toque \"Compartir\" y elija:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez maintenant ! Appuyez longuement sur un mot en gras ci-dessous pour le sélectionner, puis appuyez sur \"Partager\" et choisissez :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी आज़माएं! नीचे किसी बोल्ड शब्द को लंबे समय तक दबाएं, फिर \"शेयर\" पर टैप करें और चुनें:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ試してみましょう！下の太字の単語を長押しして選択し、「共有」をタップして選んでください："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 해보세요! 아래의 굵은 단어를 길게 눌러 선택한 다음 \"공유\"를 탭하고 선택하세요:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente agora! Pressione e segure uma palavra em negrito abaixo para selecioná-la, toque em \"Compartilhar\" e escolha:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте прямо сейчас! Удерживайте выделенное жирным слово ниже, затем нажмите «Поделиться» и выберите:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте зараз! Утримуйте виділене жирним слово нижче, щоб вибрати його, потім натисніть «Поділитися» і виберіть:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在试试吧！长按下方粗体单词以选中它，然后点击「共享」并选择："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在試試看！長按下方粗體單字以選取它，然後點選「分享」並選擇："
          }
        }
      }
    },
    "tutorial.step.popupLookup.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر نتيجة البحث في تراكب مضغوط — يمكنك تصفح المقالات، وإشارة الإدخالات كمفضلة، وضبط التكبير والمظهر، وحتى استخدام البحث السريع، كل ذلك دون تبديل التطبيقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Suchergebnis erscheint in einer kompakten Überlagerung — Sie können Artikel durchsuchen, Einträge als Lesezeichen speichern, Zoom und Erscheinungsbild anpassen und sogar die Sprungsuche verwenden, ohne die App zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lookup result appears in a compact overlay — you can browse articles, bookmark entries, adjust zooming and appearance, and even Jump Search, all without switching apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de búsqueda aparece en una superposición compacta — puede navegar por artículos, marcar entradas como favoritas, ajustar el zoom y la apariencia, e incluso usar Búsqueda Rápida, todo sin cambiar de aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de recherche apparaît dans une superposition compacte — vous pouvez parcourir les articles, ajouter des entrées aux favoris, ajuster le zoom et l'apparence, et même utiliser la Recherche Rapide, le tout sans changer d'application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज परिणाम एक कॉम्पैक्ट ओवरले में दिखाई देता है — आप ऐप बदले बिना लेख ब्राउज़ कर सकते हैं, प्रविष्टियाँ बुकमार्क कर सकते हैं, ज़ूम और रूप-रंग समायोजित कर सकते हैं, और जंप सर्च भी उपयोग कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索結果はコンパクトなオーバーレイに表示されます。アプリを切り替えることなく、記事の閲覧、エントリのブックマーク、ズームや表示設定の調整、ジャンプ検索まで行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 결과가 작은 오버레이로 표시됩니다. 앱을 전환하지 않고도 항목 탐색, 북마크 추가, 확대/축소 및 외관 조정, 점프 검색까지 모두 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da pesquisa aparece em uma sobreposição compacta — você pode navegar pelos artigos, marcar entradas, ajustar o zoom e a aparência, e até usar a Pesquisa Rápida, tudo sem trocar de aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат поиска появляется в компактном наложении — вы можете просматривать статьи, добавлять записи в закладки, регулировать масштаб и оформление, а также использовать быстрый переход, не переключая приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат пошуку з'являється у компактному оверлеї — ви можете переглядати статті, додавати записи до закладок, регулювати масштаб і зовнішній вигляд, а також використовувати швидкий перехід, не перемикаючи додатки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查词结果会以紧凑的浮层形式显示——您可以浏览词条、添加书签、调整缩放和外观，甚至使用「跳转搜索」，所有这些都无需切换应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查詞結果會以緊湊的浮層形式顯示——您可以瀏覽詞條、加入書籤、調整縮放和外觀，甚至使用「跳轉搜尋」，所有這些都無需切換應用程式。"
          }
        }
      }
    },
    "tutorial.step.zoomAndLayout.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك ضبط حجم النص باستخدام عناصر التحكم في التكبير/التصغير في شريط الأدوات أعلاه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können die Textgröße mit den Zoom-Steuerelementen in der Symbolleiste oben anpassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can adjust the text size using the zoom controls in the toolbar above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ajustar el tamaño del texto usando los controles de zoom en la barra de herramientas de arriba."
