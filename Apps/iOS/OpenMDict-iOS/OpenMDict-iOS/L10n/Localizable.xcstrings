    "lookupHistory.clearAllConfirmMessage": {
      "comment": "Alert body for clearing all lookup history",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة سجل البحث بالكامل. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gesamte Suchverlauf wird gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "All lookup history will be removed. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará todo el historial de consultas. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout l'historique de recherche sera supprimé. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सारा खोज इतिहास हटा दिया जाएगा। यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての検索履歴が削除されます。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 검색 기록이 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o histórico de consultas será removido. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся история поиска будет удалена. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уся історія пошуку буде видалена. Цю дію не можна скасувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有查询历史将被删除，此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有查詢歷史將被刪除，此操作無法復原。"
          }
        }
      }
    },
