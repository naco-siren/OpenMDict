    "aiCoach.maury.episodeBusted": {
      "comment": "Maury: all quizzes failed",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "We couldn't book an episode with any of your bookmarks. Try adding more English words with Latin or Greek roots."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックマークから番組を作成できませんでした。ラテン語やギリシャ語の語根を持つ英単語をもっと追加してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "북마크 중 어느 것으로도 에피소드를 만들 수 없었습니다. 라틴어나 그리스어 어근의 영어 단어를 더 추가해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的收藏里没有能撑起一期节目的词。试着多收藏一些带有拉丁或希腊词根的英文单词吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的書籤湊不出今天的節目。請多收藏含拉丁或希臘字根的英文單字。"
          }
        }
      }
    },
