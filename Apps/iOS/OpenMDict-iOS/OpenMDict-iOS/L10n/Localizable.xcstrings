    "troubleshoot.dangerZone.footer": {
      "comment": "Danger zone footer: explains when to use reset",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم هذا كملاذ أخير إذا كانت بياناتك تالفة أو تم التلاعب بها، أو إذا كان التطبيق يعاني من أعطال تتجاوز استكشاف الأخطاء الأساسي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende dies als letzten Ausweg, wenn deine Daten beschädigt oder manipuliert sind oder die App trotz einfacher Fehlerbehebung nicht funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this as a last resort if your data is corrupted, tampered with, or the app malfunctions beyond basic troubleshooting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa esto como último recurso si tus datos están dañados, manipulados o la app no funciona correctamente tras la resolución básica de problemas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez ceci en dernier recours si vos données sont corrompues, altérées ou si l'app dysfonctionne au-delà du dépannage de base."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपका डेटा दूषित, छेड़छाड़ किया गया है, या ऐप बुनियादी समस्या निवारण से परे खराब हो रहा है, तो इसे अंतिम उपाय के रूप में उपयोग करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データが破損・改ざんされた場合や、基本的なトラブルシューティングでは解決できない不具合が発生した場合の最終手段です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 손상되거나 변조되었거나, 기본 문제 해결로 해결할 수 없는 오류가 발생한 경우 최후의 수단으로 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use como último recurso se seus dados estiverem corrompidos, adulterados ou o app apresentar falhas que vão além da solução básica de problemas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте как крайнюю меру, если данные повреждены, изменены или приложение работает неправильно и обычное устранение неполадок не помогает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте як крайній засіб, якщо дані пошкоджені, підроблені або програма працює некоректно попри базове усунення несправностей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当数据损坏、被篡改或应用出现常规排查无法解决的故障时，将此作为最后手段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當資料損壞、遭竄改或 App 出現一般排查無法解決的故障時，將此作為最後手段。"
          }
        }
      }
    },
