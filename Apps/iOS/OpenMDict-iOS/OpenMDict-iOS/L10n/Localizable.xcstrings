    "actionExtension.loadingWithName": {
      "comment": "Action Extension: loading state (%1$@ = word, %2$@ = dictionary display name)",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث عن “%1$@” في\n“%2$@”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachschlagen von „%1$@“ in\n„%2$@“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Looking up “%1$@” in\n“%2$@”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando «%1$@» en\n«%2$@»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de « %1$@ » dans\n« %2$@ »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” में\n“%1$@” खोज रहे हैं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@”で\n“%1$@”を検索中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@”에서\n“%1$@” 검색 중"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquisando “%1$@” em\n“%2$@”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск «%1$@» в\n«%2$@»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук «%1$@» у\n«%2$@»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在“%2$@”中查询\n“%1$@”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在“%2$@”中查詢\n“%1$@”"
          }
        }
      }
    },
