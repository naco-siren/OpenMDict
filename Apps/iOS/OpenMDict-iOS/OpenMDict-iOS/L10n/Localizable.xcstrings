    "aiCoach.error.aiNotEnabled": {
      "comment": "AI Coach: Apple Intelligence not enabled error",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Apple Intelligence is not enabled on this device. Open Settings → Apple Intelligence & Siri and turn on Apple Intelligence, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは Apple Intelligence が有効になっていません。「設定」→「Apple Intelligence と Siri」を開き、Apple Intelligence をオンにしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Apple Intelligence가 활성화되어 있지 않습니다. 설정 → Apple Intelligence 및 Siri로 이동해 Apple Intelligence를 켠 다음 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备未启用 Apple 智能。请前往「设置 → Apple 智能与 Siri」开启 Apple 智能,然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置尚未啟用 Apple 智慧。請前往「設定 → Apple 智慧與 Siri」開啟 Apple 智慧後再試一次。"
          }
        }
      }
    },
    "aiCoach.error.assetsUnavailable": {
      "comment": "AI Coach: assets unavailable error",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The on-device language model assets aren't available yet. They may still be downloading — try again in a few minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイス言語モデルのアセットがまだ利用できません。ダウンロード中の可能性があります。数分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온디바이스 언어 모델 자산을 아직 사용할 수 없습니다. 다운로드가 진행 중일 수 있습니다 — 몇 분 후에 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端侧语言模型资源尚未就绪,可能仍在下载中,请几分钟后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置端語言模型資源尚未就緒,可能仍在下載中,請過幾分鐘後再試。"
          }
        }
      }
    },
    "aiCoach.error.contextTooLong": {
      "comment": "AI Coach: context window exceeded error",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The word and its dictionary definition together are too long for the on-device model (>4096 tokens). Try a shorter definition."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語と辞書定義の合計がオンデバイスモデルのコンテキスト上限を超えています（4096トークン超）。もっと短い定義をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어와 사전 정의를 합친 길이가 온디바이스 모델에 비해 너무 깁니다(>4096 토큰). 더 짧은 정의로 시도해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该词及其释义合计长度超出端侧模型的处理上限(>4096 token)。请尝试更简短的释义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單字與其字典釋義的總長度超出裝置端模型上限(>4096 tokens)。請改用較短的釋義。"
          }
        }
      }
    },
    "aiCoach.error.deviceNotEligible": {
      "comment": "AI Coach: device not eligible error",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This device does not support Apple Intelligence on-device language models. AI Coach requires an iPhone 15 Pro / iPhone 16 / Apple silicon iPad or Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは Apple Intelligence のオンデバイス言語モデルに対応していません。AI コーチは iPhone 15 Pro / iPhone 16 / Apple シリコン搭載 iPad または Mac が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 Apple Intelligence 온디바이스 언어 모델을 지원하지 않습니다. AI 코치는 iPhone 15 Pro / iPhone 16 / Apple Silicon iPad 또는 Mac이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备不支持 Apple 智能端侧语言模型。AI 教练需要 iPhone 15 Pro / iPhone 16,或搭载 Apple 芯片的 iPad 或 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本裝置不支援 Apple 智慧裝置端語言模型。AI Coach 需要 iPhone 15 Pro / iPhone 16,或配備 Apple 晶片的 iPad 或 Mac。"
          }
        }
      }
    },
    "aiCoach.error.guardrail": {
      "comment": "AI Coach: guardrail violation error",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The on-device model blocked this content (safety guardrail). Skip this word for now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモデルがこのコンテンツをブロックしました（セーフティガードレール）。この単語はスキップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온디바이스 모델이 이 콘텐츠를 차단했습니다(안전 가드레일). 지금은 이 단어를 건너뛰세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端侧模型出于安全策略屏蔽了此内容。请暂时跳过这个词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置端模型基於安全防護機制封鎖了此內容。請暫時跳過這個單字。"
          }
        }
      }
    },
    "aiCoach.error.modelNotReady": {
      "comment": "AI Coach: model not ready error",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The on-device language model is still downloading or warming up. Try again in a few minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイス言語モデルがまだダウンロード中、または準備中です。数分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온디바이스 언어 모델이 아직 다운로드 중이거나 준비 중입니다. 몇 분 후에 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端侧语言模型仍在下载或预热中,请几分钟后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置端語言模型仍在下載或暖機中,請過幾分鐘後再試。"
          }
        }
      }
    },
