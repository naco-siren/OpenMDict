    "welcome.feature.darkEnhance.body": {
      "comment": "Feature card body",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسِّن قابلية قراءة قواميس الطرف الثالث في المظهر الداكن. خصِّص درجة السطوع المثالية لكل قاموس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbessern Sie die Lesbarkeit von Drittanbieter-Wörterbüchern im Dunkelmodus. Passen Sie die ideale Helligkeit für jedes Wörterbuch individuell an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhance third-party dictionaries’ readability in dark appearance. Customize the ideal brightness for each dictionary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora la legibilidad de diccionarios de terceros en modo oscuro. Personaliza el brillo ideal para cada diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliorez la lisibilité des dictionnaires tiers en apparence sombre. Personnalisez la luminosité idéale pour chaque dictionnaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तृतीय-पक्ष शब्दकोशों की डार्क स्वरूप में पठनीयता बढ़ाएं। प्रत्येक शब्दकोश के लिए सबसे उपयुक्त चमक अनुकूलित करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サードパーティ辞書のダークモードでの読みやすさを向上。辞書ごとに最適な明暗度をカスタマイズできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서드파티 사전의 다크 모드 가독성을 향상시킵니다. 각 사전에 맞는 최적의 밝기를 설정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhore a legibilidade de dicionários de terceiros no modo escuro. Personalize o brilho ideal para cada dicionário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улучшите читаемость сторонних словарей в тёмном режиме. Настройте оптимальную яркость для каждого словаря."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покращте читабельність сторонніх словників у темному режимі. Налаштуйте оптимальну яскравість для кожного словника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提升第三方词典在深色外观下的可读性，为每本词典定制最合适的明暗度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提升第三方辭典在深色外觀下的可讀性，為每本辭典定制最合適的明暗度。"
          }
        }
      }
    },
    "welcome.feature.darkEnhance.title": {
      "comment": "Feature card title",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
