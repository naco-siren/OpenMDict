    "tutorial.step.findInPage.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرب البحث عن \"definition\" — ستظهر لك جميع النتائج مميزة بلون. استخدم الأسهم للتنقل بينها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie, nach \"definition\" zu suchen — Sie sehen alle Treffer hervorgehoben. Verwenden Sie die Pfeile, um zwischen den Treffern zu navigieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try searching for \"definition\" — you'll see all matches highlighted. Use the arrows to navigate between them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta buscar \"definition\" — verás todas las coincidencias resaltadas. Usa las flechas para navegar entre ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de rechercher \"definition\" — vous verrez toutes les correspondances surlignées. Utilisez les flèches pour naviguer entre elles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"definition\" खोजने का प्रयास करें — आप सभी मिलान हाइलाइट देखेंगे। उनके बीच नेविगेट करने के लिए तीरों का उपयोग करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"definition\" を検索してみてください。すべての一致箇所がハイライト表示されます。矢印ボタンを使って一致箇所を移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"definition\"을 검색해 보세요. 모든 일치 항목이 강조 표시됩니다. 화살표를 사용하여 항목 사이를 이동하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente pesquisar \"definition\" — você verá todas as correspondências destacadas. Use as setas para navegar entre elas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте найти \"definition\" — вы увидите все совпадения, выделенные подсветкой. Используйте стрелки для перехода между ними."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте знайти \"definition\" — ви побачите всі збіги, виділені підсвічуванням. Використовуйте стрілки для переходу між ними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试着搜索「definition」——您将看到所有匹配项被高亮显示。使用箭头在匹配项之间导航。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試著搜尋「definition」——您將看到所有符合項目被高亮顯示。使用箭頭在符合項目之間導覽。"
          }
        }
      }
    },
    "tutorial.step.importAndResources.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"استيراد قاموس\" يتيح لك إضافة ملفات قاموس MDX — عبر تطبيق الملفات أو AirDrop أو مباشرةً من هذا الزر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Wörterbuch importieren\" ermöglicht es dir, MDX-Wörterbuchdateien hinzuzufügen — über die Dateien-App, AirDrop oder direkt über diese Schaltfläche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Import Dictionary\" lets you add MDX dictionary files — via the Files app, AirDrop, or directly from this button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Importar diccionario\" te permite añadir archivos de diccionario MDX — a través de la app Archivos, AirDrop o directamente desde este botón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Importer un dictionnaire\" vous permet d'ajouter des fichiers de dictionnaire MDX — via l'app Fichiers, AirDrop ou directement depuis ce bouton."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"शब्दकोश आयात करें\" आपको Files ऐप, AirDrop या सीधे इस बटन से MDX शब्दकोश फ़ाइलें जोड़ने देता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「辞書をインポート」では、ファイル App、AirDrop、またはこのボタンから直接 MDX 辞書ファイルを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"사전 가져오기\"를 사용하면 파일 앱, AirDrop 또는 이 버튼을 통해 직접 MDX 사전 파일을 추가할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Importar Dicionário\" permite adicionar arquivos de dicionário MDX — pelo app Arquivos, AirDrop ou diretamente por este botão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Импортировать словарь\" позволяет добавлять файлы словарей MDX — через приложение \"Файлы\", AirDrop или непосредственно с этой кнопки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Імпорт словника\" дозволяє додавати файли словників MDX — через застосунок \"Файли\", AirDrop або безпосередньо з цієї кнопки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「导入词典」让您通过文件 App、AirDrop 或直接从此按钮添加 MDX 词典文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「匯入詞典」讓您透過「檔案」App、AirDrop 或直接從此按鈕新增 MDX 詞典檔案。"
          }
        }
      }
    },
    "tutorial.step.importAndResources.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر زر تحرير في شريط التنقل لإدارة قواميسك المستوردة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Schaltfläche Bearbeiten in der Navigationsleiste, um deine importierten Wörterbücher zu verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
