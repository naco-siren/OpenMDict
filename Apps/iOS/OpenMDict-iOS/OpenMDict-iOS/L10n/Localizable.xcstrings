          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载完成后未找到预期文件 %1$@(标签「%2$@」)。可能是应用打包问题,请向开发者反馈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載完成後未找到預期檔案 %1$@(標籤「%2$@」)。可能是應用程式打包問題,請向開發者回報。"
          }
        }
      }
    },
