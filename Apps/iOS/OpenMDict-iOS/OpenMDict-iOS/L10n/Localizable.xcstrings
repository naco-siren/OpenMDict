          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку «Редактировать» в панели навигации для управления импортированными словарями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
