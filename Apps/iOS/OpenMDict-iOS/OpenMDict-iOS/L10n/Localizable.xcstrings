          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WordNet의 ℹ 버튼을 탭하여 사전 정보를 확인하고 편집하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão ℹ do WordNet para visualizar e editar as informações do dicionário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку ℹ на WordNet, чтобы просмотреть и редактировать информацию о словаре."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
