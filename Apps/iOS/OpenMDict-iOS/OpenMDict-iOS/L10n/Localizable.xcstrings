    "aiCoach.triage.solutionRegionWarning": {
      "comment": "Triage: Solution 2 warning info row — the side effects of changing device region. Solution 1 (per-app language) avoids these.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤثر تغيير المنطقة على التقويمات والعملة وإعدادات App Store الافتراضية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ändern der Region wirkt sich auf Kalender, Währung und App-Store-Standardeinstellungen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Changing Region affects calendars, currency, and App Store defaults."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la región afecta a calendarios, moneda y valores predeterminados del App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer la région modifie les calendriers, la devise et les paramètres par défaut de l'App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षेत्र बदलने से कैलेंडर, मुद्रा और App Store की डिफ़ॉल्ट सेटिंग्स प्रभावित होती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域を変更すると、カレンダー、通貨、App Store の既定設定に影響します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역을 변경하면 캘린더, 통화, App Store 기본 설정이 영향을 받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a região afeta calendários, moeda e padrões da App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение региона влияет на календари, валюту и настройки App Store по умолчанию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна регіону впливає на календар, валюту та налаштування App Store за замовчуванням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地区会影响日历、货币和 App Store 的默认设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地區會影響行事曆、貨幣和 App Store 的預設設定。"
          }
        }
      }
    },
    "aiCoach.triage.unknownMessage": {
      "comment": "Triage: generic fallback message",
      "extractionState": "extracted_with_value",
      "localizations": {
