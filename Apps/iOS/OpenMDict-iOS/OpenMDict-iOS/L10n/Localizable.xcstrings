    "syncStatus.iCloudIssue.message": {
      "comment": "Sidebar sync status alert: iCloud issue message",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مزامنة iCloud غير متوفرة حاليًا. يرجى التحقق من إعدادات iCloud واتصال الشبكة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die iCloud-Synchronisierung ist derzeit nicht verfügbar. Bitte überprüfe deine iCloud-Einstellungen und Netzwerkverbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "iCloud sync is currently unavailable. Please check your iCloud settings and network connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sincronización de iCloud no está disponible actualmente. Verifica tu configuración de iCloud y conexión de red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La synchronisation iCloud est actuellement indisponible. Veuillez vérifier vos réglages iCloud et votre connexion réseau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iCloud समन्वयन वर्तमान में अनुपलब्ध है। कृपया अपनी iCloud सेटिंग्स और नेटवर्क कनेक्शन की जाँच करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iCloud 同期は現在利用できません。iCloud の設定とネットワーク接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iCloud 동기화를 현재 사용할 수 없습니다. iCloud 설정과 네트워크 연결을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sincronização do iCloud não está disponível no momento. Verifique suas configurações do iCloud e conexão de rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Синхронизация iCloud сейчас недоступна. Проверьте настройки iCloud и сетевое подключение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Синхронізація iCloud наразі недоступна. Перевірте налаштування iCloud та мережеве з'єднання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iCloud 同步当前不可用。请检查您的 iCloud 设置和网络连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iCloud 同步目前不可用。請檢查您的 iCloud 設定和網路連線。"
          }
        }
      }
