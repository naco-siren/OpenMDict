          "stringUnit": {
            "state": "translated",
            "value": "No se pudo determinar la disponibilidad de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déterminer la disponibilité d'iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud उपलब्धता निर्धारित करने में असमर्थ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud の利用可否を確認できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 사용 가능 여부를 확인할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a disponibilidade do iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить доступность iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити доступність iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定 iCloud 可用性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確定 iCloud 可用性。"
          }
        }
      }
    },
    "syncChooser.offlineAlertMessage": {
      "comment": "Sync chooser: alert message explaining consequences of offline mode",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تخزين قواميسك وبياناتك محليًا فقط. لن تتم مزامنتها مع أجهزتك الأخرى ولا يمكن استردادها إذا حُذف التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wörterbücher und Daten werden nur lokal gespeichert. Sie werden nicht mit deinen anderen Geräten synchronisiert und können nicht wiederhergestellt werden, wenn die App gelöscht wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your dictionaries and data will be stored locally only. They will not sync to your other devices and cannot be recovered if the app is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus diccionarios y datos se almacenarán solo de forma local. No se sincronizarán con tus otros dispositivos y no se podrán recuperar si se elimina la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos dictionnaires et données seront stockés localement uniquement. Ils ne seront pas synchronisés sur vos autres appareils et ne pourront pas être récupérés si l’application est supprimée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके शब्दकोश और डेटा केवल स्थानीय रूप से संग्रहीत होंगे। वे आपके अन्य उपकरणों से सिंक नहीं होंगे और ऐप हटाने पर पुनर्प्राप्त नहीं किए जा सकते।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書とデータはこのデバイスにのみ保存されます。他のデバイスとは同期されず、アプリを削除した場合は復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전과 데이터가 이 기기에만 저장됩니다. 다른 기기와 동기화되지 않으며, 앱을 삭제하면 복구할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dicionários e dados serão armazenados apenas localmente. Eles não serão sincronizados com seus outros dispositivos e não poderão ser recuperados se o app for excluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши словари и данные будут храниться только на этом устройстве. Они не будут синхронизироваться с другими устройствами и не могут быть восстановлены при удалении приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші словники та дані зберігатимуться лише локально. Вони не синхронізуватимуться з іншими пристроями і не можуть бути відновлені після видалення програми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的词典和数据将仅存储在本地。它们不会同步到你的其他设备，删除应用后也无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的辭典和資料將僅儲存在本機。它們不會同步到你的其他裝置，刪除 App 後也無法恢復。"
          }
        }
      }
    },
