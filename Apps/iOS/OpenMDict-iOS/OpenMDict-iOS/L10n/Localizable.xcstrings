    "syncStatus.cannotSync.tooLargeMessage": {
      "comment": "Sidebar sync status alert: too large message. %1$@ = dictionary name, %2$@ = file size",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” (%2$@) يتجاوز حد المزامنة الحالي (500 ميغابايت) ولا يمكن مزامنته مع iCloud. يتم تخزينه محليًا على هذا الجهاز فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%1$@“ (%2$@) überschreitet das aktuelle Synchronisierungslimit (500 MB) und kann nicht mit iCloud synchronisiert werden. Es wird nur auf diesem Gerät gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” (%2$@) exceeds the current sync size limit (500 MB) and cannot be synced to iCloud. It is stored locally on this device only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” (%2$@) supera el límite actual de sincronización (500 MB) y no puede sincronizarse con iCloud. Se almacena solo en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %1$@ » (%2$@) dépasse la limite actuelle de synchronisation (500 Mo) et ne peut pas être synchronisé avec iCloud. Il est stocké uniquement sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” (%2$@) वर्तमान समन्वयन सीमा (500 MB) से अधिक है और iCloud में समन्वयित नहीं हो सकता। यह केवल इस डिवाइस पर स्थानीय रूप से संग्रहीत है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@”（%2$@）は現在の同期サイズ制限（500 MB）を超えており、iCloud に同期できません。このデバイスにのみローカル保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@”(%2$@)은(는) 현재 동기화 크기 제한(500 MB)을 초과하여 iCloud에 동기화할 수 없습니다. 이 기기에만 로컬로 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” (%2$@) excede o limite atual de sincronização (500 MB) e não pode ser sincronizado com o iCloud. Está armazenado apenas neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%1$@» (%2$@) превышает текущий лимит синхронизации (500 МБ) и не может быть синхронизирован с iCloud. Он хранится только на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%1$@» (%2$@) перевищує поточний ліміт синхронізації (500 МБ) і не може бути синхронізований з iCloud. Він зберігається лише на цьому пристрої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@”（%2$@）超出了当前的同步大小限制（500 MB），无法同步到 iCloud。它仅存储在此设备本地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@”（%2$@）超出了當前的同步大小限制（500 MB），無法同步到 iCloud。它僅儲存在此裝置本地。"
          }
        }
      }
    },
