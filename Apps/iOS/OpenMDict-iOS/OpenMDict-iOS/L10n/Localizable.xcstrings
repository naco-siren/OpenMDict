    "aiCoach.quiz.leaveMessage": {
      "comment": "Word Tinder: back-nav alert body — leans into ghosting + waiting-match dating-app tropes",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your match is still in your queue, smiling, hoping for a yes. Walk away and you'll ghost them forever."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのマッチはキューであなたに微笑みかけ、「はい」を待っています。今去れば、相手を永遠にゴーストすることになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 매칭 상대가 큐에서 미소를 지으며 \"예스\"를 기다리고 있어요. 지금 떠나면 영원히 그들을 잠수타게 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的对象还在队列里对你微笑，等你的\"yes\"。现在走，就是永远把人家放鸽子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的對象還在隊列裡對你微笑，等你的「yes」。現在走，就是永遠把人家放鴿子。"
          }
        }
      }
    },
