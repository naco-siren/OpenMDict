          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois dispositions d’articles sur iPadOS"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadOS पर तीन आर्टिकल लेआउट"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadOSの3つの記事レイアウト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadOS에서 3가지 아티클 레이아웃"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três layouts de artigos no iPadOS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три макета статей на iPadOS"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Три макети статей на iPadOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadOS 三种文章布局"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadOS 三種文章佈局"
          }
        }
      }
    },
    "welcome.feature.multiWindow.body": {
      "comment": "Feature card body",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمتع بإنتاجية بمستوى سطح المكتب على iPadOS مع دعم النوافذ المتعددة ولوحة المفاتيح الكاملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genießen Sie Desktop-Produktivität auf iPadOS mit Multi-Fenster- und voller Tastaturunterstützung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoy desktop-class productivity on iPadOS with multi-window and full keyboard support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de productividad de escritorio en iPadOS con soporte multiventana y teclado completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez d’une productivité digne d’un ordinateur sur iPadOS avec le multifênêtrage et la prise en charge complète du clavier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadOS पर मल्टी-विंडो और पूर्ण कीबोर्ड सपोर्ट के साथ डेस्कटॉप जैसी उत्पादकता का आनंद लें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadOSでマルチウインドウとフルキーボードに対応し、デスクトップ級の生産性を実現。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadOS에서 멀티 윈도우와 풀 키보드를 지원하여 데스크톱급 생산성을 경험하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproveite produtividade de desktop no iPadOS com suporte a múltiplas janelas e teclado completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наслаждайтесь продуктивностью настольного класса на iPadOS с поддержкой нескольких окон и полной клавиатуры."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Насолоджуйтесь продуктивністю настільного класу на iPadOS з підтримкою кількох вікон та повної клавіатури."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPadOS 上享受桌面级工作效率，支持多窗口和全键盘操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPadOS 上享受桌面級工作效率，支援多視窗和全鍵盤操作。"
          }
        }
      }
    },
    "welcome.feature.multiWindow.title": {
      "comment": "Feature card title",
      "extractionState": "manual",
      "localizations": {
        "ar": {
