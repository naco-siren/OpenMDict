    "troubleshoot.clearCloud.description": {
      "comment": "Subtitle for the nuclear reset button",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف جميع بياناتك المتزامنة على iCloud، كما هو مذكور أعلاه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht ALLE synchronisierten Daten in iCloud (wie oben aufgelistet)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes ALL your synced data on iCloud, as listed above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina TODOS tus datos sincronizados en iCloud, como se indica arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime TOUTES vos données synchronisées sur iCloud, comme indiqué ci-dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud पर आपका सभी सिंक किया गया डेटा हटाता है, जैसा कि ऊपर सूचीबद्ध है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上記の iCloud 上のすべての同期データを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에 나열된 iCloud의 모든 동기화 데이터를 삭제합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui TODOS os seus dados sincronizados no iCloud, conforme listado acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет ВСЕ синхронизированные данные в iCloud (перечислены выше)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє ВСІ синхронізовані дані в iCloud (перелічені вище)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 iCloud 上所有已同步的数据（如上所列）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 iCloud 上所有已同步的資料（如上所列）。"
          }
        }
      }
    },
    "troubleshoot.clearCloud.title": {
      "comment": "Button: nuclear reset — delete all synced data and reset app",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح بيانات iCloud وإعادة تعيين التطبيق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Daten löschen und App zurücksetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear iCloud Data and Reset App"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar datos de iCloud y restablecer la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer les données iCloud et réinitialiser l'app"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud डेटा मिटाएँ और ऐप रीसेट करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud データを消去してAppをリセット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 데이터 지우기 및 앱 재설정"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar dados do iCloud e redefinir o app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить данные iCloud и сбросить приложение"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистити дані iCloud та скинути програму"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除 iCloud 数据并重置应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除 iCloud 資料並重置 App"
          }
        }
      }
    },
    "troubleshoot.clearLocal.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف جميع بياناتك المحلية على هذا الجهاز فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht ALLE lokalen Daten nur auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes ALL your local data on this device alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina TODOS tus datos locales solo en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime TOUTES vos données locales sur cet appareil uniquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल इस डिवाइस पर आपका सभी स्थानीय डेटा हटाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのすべてのローカルデータのみを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 모든 로컬 데이터만 삭제합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui TODOS os seus dados locais somente neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет ВСЕ локальные данные только на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє ВСІ локальні дані лише на цьому пристрої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除此设备上的所有本地数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅刪除此裝置上的所有本機資料。"
          }
        }
      }
