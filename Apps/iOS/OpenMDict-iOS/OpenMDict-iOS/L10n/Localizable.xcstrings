    "welcome.feature.layouts.body": {
      "comment": "Feature card body",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض تعريفات متعددة من قواميس مختلفة بتخطيط الأعمدة أو الشبكة أو القائمة، كلها في آن واحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie mehrere Definitionen aus verschiedenen Wörterbüchern gleichzeitig in Spalten-, Raster- oder Listenansicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View multiple definitions from different dictionaries in Columns, Grid or List, all at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiza múltiples definiciones de diferentes diccionarios en Columnas, Cuadrícula o Lista, todo a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez plusieurs définitions issues de différents dictionnaires simultanément, en colonnes, en grille ou en liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉलम, ग्रिड या लिस्ट में विभिन्न शब्दकोशों से अनेक परिभाषाएँ एक साथ देखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カラム、グリッド、リストで複数の辞書の定義を一度に表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카럼, 그리드 또는 리스트로 여러 사전의 정의를 한 번에 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualize múltiplas definições de diferentes dicionários em Colunas, Grade ou Lista, tudo de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте определения из разных словарей в режимах столбцов, сетки или списка одновременно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте визначення з різних словників у режимах стовпців, сітки або списку одночасно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPadOS 上同时查看来自不同词典的多个释义，支持分栏、网格和列表布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPadOS 上同時檢視來自不同辭典的多個釋義，支援分欄、網格和列表佈局。"
          }
        }
      }
    },
    "welcome.feature.layouts.title": {
      "comment": "Feature card title",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاثة تخطيطات للمقالات على iPadOS"
          }
        },
        "de": {
          "stringUnit": {
