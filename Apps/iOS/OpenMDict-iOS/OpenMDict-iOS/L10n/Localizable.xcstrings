    "syncChooser.errorTemporarilyUnavailable": {
      "comment": "Sync chooser: error when iCloud is temporarily unavailable",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud غير متاح مؤقتًا. يرجى المحاولة مرة أخرى لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist vorübergehend nicht verfügbar. Bitte versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is temporarily unavailable. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no está disponible temporalmente. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est temporairement indisponible. Veuillez réessayer plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud अस्थायी रूप से अनुपलब्ध है। कृपया बाद में पुनः प्रयास करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud は一時的に利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud를 일시적으로 사용할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está temporariamente indisponível. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud временно недоступен. Пожалуйста, попробуйте позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud тимчасово недоступний. Будь ласка, спробуйте пізніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 暂时不可用。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 暫時無法使用。請稍後重試。"
          }
        }
      }
    },
    "syncChooser.errorUnknown": {
      "comment": "Sync chooser: generic error when iCloud check fails",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحديد توفر iCloud."
          }
        },
        "de": {
