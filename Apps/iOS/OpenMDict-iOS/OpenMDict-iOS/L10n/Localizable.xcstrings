    "welcome.feature.noLimits.body": {
      "comment": "Feature card body",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استورد قواميس غير محدودة وأنشئ مجموعات غير محدودة، بدون أي اشتراكات أو عضويات مدفوعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie unbegrenzt Wörterbücher und erstellen Sie unbegrenzt Gruppen — ohne Abonnements oder kostenpflichtige Mitgliedschaften."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import unlimited dictionaries and create unlimited groups, without any subscriptions or paid memberships."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa diccionarios ilimitados y crea grupos ilimitados, sin suscripciones ni membresías de pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un nombre illimité de dictionnaires et créez autant de groupes que vous le souhaitez, sans abonnement ni adhésion payante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असीमित शब्दकोश आयात करें और असीमित समूह बनाएँ, बिना किसी सब्सक्रिप्शन या सशुल्क सदस्यता के।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書もグループも無制限に追加可能。サブスクリプションや有料会員は一切不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전과 그룹을 무제한으로 추가할 수 있습니다. 구독이나 유료 멤버십이 필요 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe dicionários ilimitados e crie grupos ilimitados, sem assinaturas ou planos pagos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте неограниченное количество словарей и создавайте неограниченное количество групп без подписок и платных тарифов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортуйте необмежену кількість словників та створюйте необмежену кількість груп без підписок чи платних тарифів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无限导入词典，无限创建分组，无需订阅或付费会员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無限匯入辭典，無限建立群組，無需訂閱或付費會員。"
          }
        }
      }
    },
