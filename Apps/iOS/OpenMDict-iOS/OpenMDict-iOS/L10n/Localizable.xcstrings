        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dictionnaire ne peut pas être mis à jour pour le moment. Réessayez dans un instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस शब्दकोश को अभी अपडेट नहीं किया जा सकता। थोड़ी देर में फिर से कोशिश करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この辞書は今は更新できません。少し待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 이 사전을 업데이트할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível atualizar este dicionário agora. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас этот словарь нельзя обновить. Повторите попытку чуть позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз цей словник не можна оновити. Спробуйте ще раз трохи згодом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法更新此词典，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法更新此辭典，請稍後再試。"
          }
        }
      }
    },
