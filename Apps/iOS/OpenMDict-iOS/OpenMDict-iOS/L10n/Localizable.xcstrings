    "welcome.feature.presets.body": {
      "comment": "Feature card body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick your starter pack from our curated selection of open-source dictionaries, ready to use with minimum setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从我们精选的开源词典中挑选你的入门词库，开箱即用，设置极简。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從我們精選的開源辭典中挑選你的入門詞庫，開箱即用，設定極簡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳選されたオープンソース辞書からスターターパックを選びましょう。最小限のセットアップですぐに使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄선된 오픈소스 사전에서 스타터 팩을 골라보세요. 최소한의 설정으로 바로 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите стартовый набор из нашей подборки словарей с открытым исходным кодом — готовы к использованию с минимальной настройкой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть стартовий набір із нашої добірки словників з відкритим кодом — готові до використання з мінімальним налаштуванням."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu pack inicial de nuestra selección curada de diccionarios de código abierto, listos para usar con una configuración mínima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha seu pacote inicial da nossa seleção curada de dicionários de código aberto, prontos para usar com configuração mínima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Ihr Starterpaket aus unserer kuratierten Auswahl an Open-Source-Wörterbüchern — sofort einsatzbereit mit minimaler Einrichtung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre pack de démarrage parmi notre sélection de dictionnaires open source, prêts à l'emploi avec un minimum de configuration."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر حزمتك الأولى من مجموعتنا المختارة من القواميس مفتوحة المصدر، جاهزة للاستخدام بأقل إعداد ممكن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमारे चुनिंदा ओपन-सोर्स शब्दकोशों में से अपना स्टार्टर पैक चुनें — न्यूनतम सेटअप के साथ उपयोग के लिए तैयार।"
          }
        }
      }
    },
