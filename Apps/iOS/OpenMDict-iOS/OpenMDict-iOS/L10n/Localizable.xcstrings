          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes de escurecimento para dicionários importados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улучшения тёмного режима для импортированных словарей"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покращення темного режиму для імпортованих словників"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入词典的暗色增强"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入辭典的暗色增強"
          }
        }
      }
    },
    "welcome.feature.extensions.body": {
      "comment": "Feature card body for Action Extension + jump search",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن الكلمات من أي تطبيق في نافذة منبثقة، ثم تابع البحث المتسلسل عن المصطلحات غير المألوفة في التعريفات حتى تتضح كل كلمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlagen Sie Wörter aus jeder App in einem Pop-up nach und suchen Sie unbekannte Begriffe in Definitionen per Sprungsuche weiter — bis jedes Wort klar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look up words from any app in a pop-up, then keep jump-searching unfamiliar terms within definitions until every word is clear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca palabras desde cualquier app en una ventana emergente y sigue buscando términos desconocidos en las definiciones hasta que cada palabra quede clara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez des mots depuis n'importe quelle app dans une fenêtre contextuelle, puis enchaînez les recherches sur les termes inconnus dans les définitions jusqu'à ce que tout soit clair."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी ऐप से पॉप-अप में शब्द खोजें, फिर परिभाषा में अपरिचित शब्दों को जंप-सर्च करते रहें — जब तक हर शब्द स्पष्ट न हो जाए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでもポップアップで単語を検索。定義の中の知らない単語をジャンプ検索し続けて、すべての単語が分かるまで掘り下げましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 앱에서든 팝업으로 단어를 검색한 후, 정의 안의 모르는 단어를 점프 검색하며 모든 단어가 명확해질 때까지 이어가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte palavras de qualquer app em um pop-up e continue pesquisando termos desconhecidos nas definições até que cada palavra fique clara."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите слова из любого приложения во всплывающем окне, а затем продолжайте искать незнакомые термины в определениях, пока каждое слово не станет понятным."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукайте слова з будь-якого застосунку у спливаючому вікні, а потім продовжуйте шукати незнайомі терміни у визначеннях, доки кожне слово не стане зрозумілим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 中通过弹窗查词，再对释义中的生词连续跳查，直到每个词都弄清楚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 中透過彈窗查詞，再對釋義中的生詞連續跳查，直到每個詞都弄清楚。"
          }
        }
      }
    },
