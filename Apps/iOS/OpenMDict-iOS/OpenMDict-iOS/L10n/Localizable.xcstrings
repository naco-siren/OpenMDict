    "troubleshoot.localConfirm1.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جميع القواميس والإشارات المرجعية والسجل والمجموعات على هذا الجهاز نهائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht dauerhaft alle Wörterbücher, Lesezeichen, den Verlauf und Gruppen auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete all dictionaries, bookmarks, history, and groups on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente todos los diccionarios, marcadores, historial y grupos en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera définitivement tous les dictionnaires, signets, l'historique et les groupes sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस डिवाइस पर सभी शब्दकोश, बुकमार्क, इतिहास और समूह स्थायी रूप से हटा देगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス上のすべての辞書、ブックマーク、履歴、グループが完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 모든 사전, 북마크, 기록 및 그룹이 영구적으로 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso excluirá permanentemente todos os dicionários, favoritos, histórico e grupos neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит все словари, закладки, историю и группы на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить усі словники, закладки, історію та групи на цьому пристрої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将永久删除此设备上的所有词典、书签、历史记录和分组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作將永久刪除此裝置上的所有辭典、書籤、歷史記錄和群組。"
          }
        }
      }
    },
    "troubleshoot.localConfirm1.title": {
      "extractionState": "manual",
      "localizations": {
