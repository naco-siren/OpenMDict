    "common.discardChanges.message" : {
      "comment" : "Alert body: discard unsaved changes",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك تغييرات غير محفوظة. هل أنت متأكد من تجاهلها؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben ungesicherte Änderungen. Möchten Sie diese wirklich verwerfen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have unsaved changes. Are you sure you want to discard them?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes cambios sin guardar. ¿Estás seguro de que deseas descartarlos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez des modifications non enregistrées. Voulez-vous vraiment les ignorer ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पास असुरक्षित परिवर्तन हैं। क्या आप वाकई उन्हें त्यागना चाहते हैं?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されていない変更があります。破棄してもよろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장되지 않은 변경 사항이 있습니다. 정말 폐기하시겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem alterações não salvas. Tem certeza de que deseja descartá-las?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас есть несохранённые изменения. Вы уверены, что хотите их отменить?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас є незбережені зміни. Ви впевнені, що хочете їх відхилити?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有未保存的更改。确定要放弃吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有未儲存的更改。確定要捨棄嗎？"
          }
        }
      }
    },
