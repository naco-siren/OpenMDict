    "aiCoach.triage.deviceMessage": {
      "comment": "Triage: device not eligible. Arg = marketing chip name from DeviceChipInfo, e.g. 'Apple A13 Bionic'.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device's chip (%@) doesn't support Apple Intelligence. AI Coach needs an iPhone 15 Pro / 16 or newer, or an iPad with an M-series chip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI コーチには Apple Intelligence に対応したデバイス（iPhone 15 Pro や M1 チップ以降を搭載した iPad など）が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 코치는 iPhone 15 Pro 또는 M1 이상 칩을 탑재한 iPad와 같이 Apple Intelligence를 지원하는 기기가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备的芯片(%@)不支持 Apple 智能。AI 教练需要 iPhone 15 Pro / 16 或更新机型，或搭载 M 系列芯片的 iPad。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本裝置的晶片(%@)不支援 Apple 智慧。AI 教練需要 iPhone 15 Pro / 16 或更新機型，或搭載 M 系列晶片的 iPad。"
          }
        }
      }
    },
