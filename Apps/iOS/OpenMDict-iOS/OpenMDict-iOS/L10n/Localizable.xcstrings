    "aiCoach.triage.fallbackMessage": {
      "comment": "Triage: fallback message when neither Solution 1 nor Solution 2 has any candidates (rare — e.g. ru-RU where neither Russian nor Russia is in Apple's supported list).",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence غير متوفرة لمزيج لغتك ومنطقتك. لاستخدام المدرب الذكي، غيّر لغة iPhone والمنطقة في الإعدادات إلى مزيج مدعوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist für deine Kombination aus Sprache und Region nicht verfügbar. Um AI Coach zu nutzen, ändere die iPhone-Sprache und Region in den Einstellungen auf eine unterstützte Kombination."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Apple Intelligence isn't available for your language and region combination. To use AI Coach, change your iPhone Language and Region in Settings to a supported combination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no está disponible para tu combinación de idioma y región. Para usar AI Coach, cambia el idioma y la región del iPhone en Ajustes a una combinación compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence n'est pas disponible pour votre combinaison langue/région. Pour utiliser AI Coach, modifiez la langue et la région de l'iPhone dans Réglages pour une combinaison prise en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence आपकी भाषा और क्षेत्र संयोजन के लिए उपलब्ध नहीं है। AI कोच का उपयोग करने के लिए, सेटिंग्स में iPhone भाषा और क्षेत्र को समर्थित संयोजन में बदलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence はお使いの言語と地域の組み合わせに対応していません。AI コーチを使用するには、設定で iPhone の言語と地域を対応する組み合わせに変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence는 사용 중인 언어와 지역 조합을 지원하지 않습니다. AI 코치를 사용하려면 설정에서 iPhone 언어와 지역을 지원되는 조합으로 변경하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence não está disponível para sua combinação de idioma e região. Para usar o AI Coach, altere o idioma e a região do iPhone nos Ajustes para uma combinação compatível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence недоступен для вашей комбинации языка и региона. Чтобы использовать ИИ-наставника, измените язык и регион iPhone в Настройках на поддерживаемую комбинацию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence недоступний для вашої комбінації мови та регіону. Щоб користуватися AI-наставником, змініть мову та регіон iPhone у Налаштуваннях на підтримувану комбінацію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能不支持您当前的语言与地区组合。若要使用 AI 教练，请在设置中将 iPhone 语言和地区改为受支持的组合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能不支援您目前的語言與地區組合。若要使用 AI 教練，請在設定中將 iPhone 語言和地區改為受支援的組合。"
          }
        }
      }
    },
