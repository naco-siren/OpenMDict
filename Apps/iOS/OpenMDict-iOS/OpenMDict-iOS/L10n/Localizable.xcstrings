    "bookmarks.removeBookmarkMessage": {
      "comment": "Alert body confirming bookmark removal; first %@ is the word, second %@ is the dictionary name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\nمن %2$@\nستتم إزالته من إشاراتك المرجعية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\naus %2$@\nwird aus deinen Lesezeichen entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@”\nfrom %2$@\nwill be removed from your bookmarks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\nde %2$@\nse eliminará de tus marcadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\nde %2$@\nsera supprimé de vos signets."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n%2$@ से\nआपके बुकमार्क से हटा दिया जाएगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n（%2$@）\nをブックマークから削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n(%2$@)\n이(가) 북마크에서 제거됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\nde %2$@\nserá removido dos seus favoritos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\nиз %2$@\nбудет удалено из ваших закладок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\nз %2$@\nбуде видалено з ваших закладок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n来自 %2$@\n将从你的书签中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n來自 %2$@\n將從你的書籤中移除。"
          }
        }
      }
    },
