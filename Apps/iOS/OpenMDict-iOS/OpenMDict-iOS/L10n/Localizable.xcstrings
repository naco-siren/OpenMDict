    "troubleshoot.confirm2.message": {
      "comment": "Alert 2 message: final warning, partially caps",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا الإجراء!\nستحتاج إلى إعداد هذا التطبيق من جديد واستيراد قواميسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DIES KANN NICHT RÜCKGÄNGIG GEMACHT WERDEN!\nSie müssen diese App erneut einrichten und Ihre Wörterbücher importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "THIS CANNOT BE UNDONE!\nYou will need to set up this app again and import your dictionaries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ESTO NO SE PUEDE DESHACER!\nDeberá configurar esta app de nuevo e importar sus diccionarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CETTE ACTION EST IRRÉVERSIBLE !\nVous devrez reconfigurer cette app et réimporter vos dictionnaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पूर्ववत नहीं किया जा सकता!\nआपको इस ऐप को फिर से सेट अप करना होगा और अपने शब्दकोश आयात करने होंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません！\nアプリを再設定し、辞書を再インポートする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없습니다!\n앱을 다시 설정하고 사전을 다시 가져와야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ESTA AÇÃO NÃO PODE SER DESFEITA!\nVocê precisará configurar este app novamente e importar seus dicionários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЭТО ДЕЙСТВИЕ НЕЛЬЗЯ ОТМЕНИТЬ!\nВам потребуется заново настроить приложение и импортировать словари."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ЦЮ ДІЮ НЕ МОЖНА СКАСУВАТИ!\nВам потрібно буде заново налаштувати застосунок та імпортувати словники."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销！\n你需要重新设置本 App 并重新导入词典。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作無法復原！\n你需要重新設定本 App 並重新匯入辭典。"
          }
        }
      }
    },
    "troubleshoot.confirm2.title": {
      "comment": "Alert 2 title: final confirmation, all caps",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد تمامًا من أنك تريد مسح جميع بيانات iCloud لهذا التطبيق؟!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SIND SIE SICHER, DASS SIE ALLE ICLOUD-DATEN FÜR DIESE APP LÖSCHEN MÖCHTEN?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "ARE YOU SURE YOU WANT TO CLEAR ALL ICLOUD DATA FOR THIS APP?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ESTA SEGURO DE QUE DESEA BORRAR TODOS LOS DATOS DE ICLOUD PARA ESTA APP?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ÊTES-VOUS SÛR DE VOULOIR EFFACER TOUTES LES DONNÉES ICLOUD POUR CETTE APP ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई इस ऐप का सारा iCloud डेटा मिटाना चाहते हैं?!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当にこのアプリの iCloud データをすべて消去しますか！？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말로 이 앱의 모든 iCloud 데이터를 지우시겠습니까!?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "TEM CERTEZA DE QUE DESEJA APAGAR TODOS OS DADOS DO ICLOUD PARA ESTE APP?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВЫ УВЕРЕНЫ, ЧТО ХОТИТЕ УДАЛИТЬ ВСЕ ДАННЫЕ ICLOUD ДЛЯ ЭТОГО ПРИЛОЖЕНИЯ?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ВИ ВПЕВНЕНІ, ЩО ХОЧЕТЕ ВИДАЛИТИ ВСІ ДАНІ ICLOUD ДЛЯ ЦЬОГО ЗАСТОСУНКУ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要清除本 App 的所有 iCloud 数据吗！？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要清除本 App 的所有 iCloud 資料嗎！？"
          }
        }
      }
    },
