    "troubleshoot.status.footer.disabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتفعيل مزامنة iCloud، استخدم خيار إعادة التعيين أدناه أو أعد تثبيت التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die iCloud-Synchronisierung zu aktivieren, nutze die Zurücksetzen-Option unten oder installiere die App neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To enable iCloud sync, use the reset option below or reinstall the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para activar la sincronización con iCloud, usa la opción de restablecer abajo o reinstala la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour activer la synchronisation iCloud, utilisez l'option de réinitialisation ci-dessous ou réinstallez l'app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud सिंक सक्षम करने के लिए, नीचे दिए गए रीसेट विकल्प का उपयोग करें या ऐप को पुनः इंस्टॉल करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同期を有効にするには、下のリセットオプションを使用するか、アプリを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화를 활성화하려면 아래의 재설정 옵션을 사용하거나 앱을 다시 설치하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ativar a sincronização com o iCloud, use a opção de redefinir abaixo ou reinstale o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы включить синхронизацию с iCloud, используйте сброс ниже или переустановите приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб увімкнути синхронізацію з iCloud, скористайтеся опцією скидання нижче або перевстановіть застосунок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需启用 iCloud 同步，请使用下方的重置选项或重新安装应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需啟用 iCloud 同步，請使用下方的重置選項或重新安裝應用程式。"
          }
        }
      }
    },
    "troubleshoot.status.footer.enabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتغيير وضع المزامنة، استخدم خيار إعادة التعيين أدناه أو أعد تثبيت التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den Synchronisierungsmodus zu ändern, nutze die Zurücksetzen-Option unten oder installiere die App neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To change your sync mode, use the reset option below or reinstall the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cambiar el modo de sincronización, usa la opción de restablecer abajo o reinstala la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour changer le mode de synchronisation, utilisez l'option de réinitialisation ci-dessous ou réinstallez l'app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना सिंक मोड बदलने के लिए, नीचे दिए गए रीसेट विकल्प का उपयोग करें या ऐप को पुनः इंस्टॉल करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期モードを変更するには、下のリセットオプションを使用するか、アプリを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 모드를 변경하려면 아래의 재설정 옵션을 사용하거나 앱을 다시 설치하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para alterar o modo de sincronização, use a opção de redefinir abaixo ou reinstale o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы изменить режим синхронизации, используйте сброс ниже или переустановите приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб змінити режим синхронізації, скористайтеся опцією скидання нижче або перевстановіть застосунок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需更改同步模式，请使用下方的重置选项或重新安装应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需更改同步模式，請使用下方的重置選項或重新安裝應用程式。"
          }
        }
      }
    },
    "troubleshoot.syncStatus.subtitle.disabled": {
