        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить локальные данные и сбросить приложение"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистити локальні дані та скинути програму"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除本地数据并重置应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除本機資料並重置 App"
          }
        }
      }
    },
    "troubleshoot.confirm1.message": {
      "comment": "Alert 1 message: first confirmation for nuclear reset",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيؤدي هذا إلى حذف جميع الإشارات المرجعية والسجل والمجموعات وملفات القواميس المتزامنة من iCloud نهائيًا.\n\nسيتم أيضًا إعادة تعيين هذا التطبيق على جميع الأجهزة الأخرى التي تستخدم حساب iCloud هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies löscht dauerhaft ALLE synchronisierten Lesezeichen, den Verlauf, Gruppen und Wörterbuchdateien aus iCloud.\n\nDiese App auf ALLEN anderen Geräten, die dieses iCloud-Konto verwenden, wird ebenfalls zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This will permanently delete ALL synced bookmarks, history, groups, and dictionary files from iCloud.\n\nThis app on ALL other devices using this iCloud account will also be reset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto eliminará permanentemente TODOS los marcadores, historial, grupos y archivos de diccionarios sincronizados de iCloud.\n\nEsta app en TODOS los demás dispositivos que usan esta cuenta de iCloud también se restablecerá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela supprimera définitivement TOUS les signets, l'historique, les groupes et les fichiers de dictionnaires synchronisés d'iCloud.\n\nCette app sur TOUS les autres appareils utilisant ce compte iCloud sera également réinitialisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह iCloud से सभी सिंक किए गए बुकमार्क, इतिहास, समूह और शब्दकोश फ़ाइलों को स्थायी रूप से हटा देगा।\n\nइस iCloud खाते का उपयोग करने वाले अन्य सभी उपकरणों पर भी यह ऐप रीसेट हो जाएगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この操作により、iCloud 上の同期済みブックマーク、検索履歴、グループ、辞書ファイルがすべて完全に削除されます。\n\nこの iCloud アカウントを使用している他のすべてのデバイスの本アプリもリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업은 iCloud에 동기화된 모든 북마크, 검색 기록, 그룹 및 사전 파일을 영구적으로 삭제합니다.\n\n이 iCloud 계정을 사용하는 다른 모든 기기의 이 앱도 초기화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso excluirá permanentemente TODOS os favoritos, histórico, grupos e arquivos de dicionários sincronizados do iCloud.\n\nEste app em TODOS os outros dispositivos que usam esta conta do iCloud também será redefinido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это безвозвратно удалит ВСЕ синхронизированные закладки, историю, группы и файлы словарей из iCloud.\n\nЭто приложение на ВСЕХ других устройствах, использующих эту учётную запись iCloud, также будет сброшено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Це назавжди видалить УСІ синхронізовані закладки, історію, групи та файли словників з iCloud.\n\nЦей застосунок на УСІХ інших пристроях, які використовують цей обліковий запис iCloud, також буде скинуто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作将永久删除 iCloud 上所有已同步的书签、历史记录、分组和词典文件。\n\n使用此 iCloud 账户的所有其他设备上的本 App 也将被重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作將永久刪除 iCloud 上所有已同步的書籤、查詢紀錄、群組和辭典檔案。\n\n使用此 iCloud 帳號的所有其他裝置上的本 App 也將被重置。"
          }
        }
      }
    },
