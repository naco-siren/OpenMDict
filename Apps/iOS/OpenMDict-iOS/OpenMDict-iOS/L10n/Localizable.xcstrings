    "groupInfo.deleteGroupMessage": {
      "comment": "Alert body for group delete; %@ is the group name",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف “%@”؟ لن يتم إزالة القواميس الموجودة في هذه المجموعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” löschen? Wörterbücher in dieser Gruppe werden nicht entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”? Dictionaries in this group will not be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar “%@”? Los diccionarios de este grupo no se eliminarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer “%@” ? Les dictionnaires de ce groupe ne seront pas supprimés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” हटाएँ? इस समूह के शब्दकोश हटाए नहीं जाएँगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”を削除しますか？グループ内の辞書は削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) 삭제하시겠습니까? 그룹 내 사전은 삭제되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar “%@”? Os dicionários deste grupo não serão removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить “%@”? Словари в этой группе не будут удалены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити “%@”? Словники в цій групі не будуть видалені."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除“%@”？分组中的词典不会被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除“%@”？群組中的辭典不會被移除。"
          }
        }
      }
    },
