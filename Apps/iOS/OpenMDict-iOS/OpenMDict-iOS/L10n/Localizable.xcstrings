{
  "sourceLanguage": "en",
  "strings": {
    "actionExtension.browseEntryMessage": {
      "comment": "Action Extension: alert message for entry link (%@ = dictionary display name)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى OpenMDict واعرض التعريف الكامل في “%@”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne OpenMDict und zeige die vollständige Definition in „%@“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to OpenMDict and view its full definition in “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir a OpenMDict y ver la definición completa en «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir OpenMDict et consulter la définition complète dans « %@ »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict में जाकर “%@” में पूरी परिभाषा देखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict を開いて“%@”で完全な定義を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict로 이동하여 “%@”에서 전체 정의를 확인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir para o OpenMDict e ver a definição completa em “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейти в OpenMDict и посмотреть полное определение в «%@»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейти до OpenMDict і переглянути повне визначення у «%@»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往 OpenMDict，在“%@”中查看完整释义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往 OpenMDict，在「%@」中查看完整釋義。"
          }
        }
      }
    },
    "actionExtension.browseEntryTitle": {
      "comment": "Action Extension: alert title asking user to open a dictionary entry link in the main app (%@ = target word)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصفّح “%@” في التطبيق؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ in der App nachschlagen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse “%@” in the app?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ver «%@» en la app?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulter « %@ » dans l’app ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” को ऐप में खोलें?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”をアプリで開きますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) 앱에서 열까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultar “%@” no app?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть «%@» в приложении?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянути «%@» у застосунку?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用中查看“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在應用中瀏覽「%@」？"
          }
        }
      }
    },
    "actionExtension.loading": {
      "comment": "Action Extension: loading dictionaries state",
