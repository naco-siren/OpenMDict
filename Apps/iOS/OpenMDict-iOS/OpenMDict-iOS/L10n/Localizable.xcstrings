    "tutorial.findUnavailable.message": {
      "comment": "Alert message: Find in Page not available on iOS 15",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب البحث في الصفحة iOS 16 أو أحدث. يرجى تحديث جهازك للوصول إلى هذه الميزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche auf der Seite erfordert iOS 16 oder neuer. Bitte aktualisiere dein Gerät, um diese Funktion zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Find in Page requires iOS 16 or later. Please update your device to access this feature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda en página requiere iOS 16 o posterior. Actualiza tu dispositivo para acceder a esta función."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche dans la page nécessite iOS 16 ou une version ultérieure. Veuillez mettre à jour votre appareil pour accéder à cette fonctionnalité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेज में खोज के लिए iOS 16 या उसके बाद का संस्करण आवश्यक है। इस सुविधा का उपयोग करने के लिए अपना डिवाइस अपडेट करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ内検索には iOS 16 以降が必要です。この機能を使用するにはデバイスをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지에서 찾기는 iOS 16 이상이 필요합니다. 이 기능을 사용하려면 기기를 업데이트하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca na página requer iOS 16 ou posterior. Por favor, atualize seu dispositivo para acessar este recurso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск по странице требует iOS 16 или новее. Обновите устройство, чтобы использовать эту функцию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук на сторінці вимагає iOS 16 або новіше. Будь ласка, оновіть пристрій для доступу до цієї функції."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页内查找需要 iOS 16 或更高版本。请更新设备以使用此功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁內尋找需要 iOS 16 或更高版本。請更新裝置以使用此功能。"
          }
        }
      }
    },
