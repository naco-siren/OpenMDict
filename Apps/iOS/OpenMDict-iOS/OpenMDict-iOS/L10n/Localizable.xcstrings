          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Wörterbücher verfügbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "No dictionaries available"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay diccionarios disponibles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun dictionnaire disponible"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई शब्दकोश उपलब्ध नहीं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "利用可能な辞書がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사용 가능한 사전 없음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum dicionário disponível"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нет доступных словарей"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Немає доступних словників"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无可用词典"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無可用詞典"
          }
        }
      }
    },
    "actionExtension.noResults": {
      "comment": "Action Extension: no results (%1$@ = word, %2$d = number of dictionaries searched)",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على تعريفات لـ“%1$@”\nفي أفضل %2$d قواميس لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Definitionen für „%1$@“ gefunden\nin deinen Top-%2$d-Wörterbüchern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "No definitions found for “%1$@”\nin your top %2$d dictionaries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron definiciones para “%1$@”\nen tus %2$d diccionarios principales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune définition trouvée pour « %1$@ »\ndans vos %2$d premiers dictionnaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” के लिए कोई परिभाषा नहीं मिली\nआपके शीर्ष %2$d शब्दकोशों में।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上位 %2$d 件の辞書で\n“%1$@”の定義が見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”에 대한 정의를 찾을 수 없음\n상위 %2$d개 사전에서."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma definição encontrada para “%1$@”\nnos seus %2$d principais dicionários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определения для «%1$@» не найдены\nв ваших %2$d основных словарях."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначення для «%1$@» не знайдено\nу ваших %2$d основних словниках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的前 %2$d 本词典中\n未找到“%1$@”的释义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的前 %2$d 本辭典中\n未找到「%1$@」的釋義。"
          }
        }
      }
    },
