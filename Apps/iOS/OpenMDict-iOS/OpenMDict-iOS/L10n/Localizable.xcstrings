        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível instalar a atualização. A versão anterior do dicionário continua no lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось установить обновление. Предыдущая версия словаря сохранена."
