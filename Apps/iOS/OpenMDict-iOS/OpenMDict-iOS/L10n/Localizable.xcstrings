    "tutorial.step.bookmarks.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه مقالة قاموسية. يمكنك وضع إشارة مرجعية على أي مقالة لحفظها لوقت لاحق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Wörterbucheintrag. Sie können jeden Eintrag als Lesezeichen speichern, um ihn später zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a dictionary article. You can bookmark any article to save it for later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un artículo del diccionario. Puedes marcar cualquier artículo como favorito para guardarlo y verlo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un article du dictionnaire. Vous pouvez mettre en favori n'importe quel article pour le retrouver plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक शब्दकोश लेख है। आप बाद में पढ़ने के लिए किसी भी लेख को बुकमार्क कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは辞書の記事です。任意の記事をブックマークして後で参照することができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 사전 항목입니다. 나중에 보기 위해 모든 항목을 북마크할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um artigo do dicionário. Você pode marcar qualquer artigo como favorito para salvá-lo para depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это статья словаря. Вы можете добавить любую статью в закладки, чтобы сохранить её на потом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це стаття словника. Ви можете додати будь-яку статтю до закладок, щоб зберегти її на потім."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一篇词典文章。您可以收藏任意文章，以便日后查阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是一篇詞典文章。您可以收藏任意文章，以便日後查閱。"
          }
        }
      }
    },
    "tutorial.step.bookmarks.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على زر الإشارة المرجعية المميز لحفظ هذه المقالة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die hervorgehobene Lesezeichen-Schaltfläche, um diesen Eintrag zu speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the highlighted bookmark button to save this article."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de marcador resaltado para guardar este artículo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton favori en surbrillance pour enregistrer cet article."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लेख को सहेजने के लिए हाइलाइट किए गए बुकमार्क बटन पर टैप करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライトされたブックマークボタンをタップしてこの記事を保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 표시된 북마크 버튼을 탭하여 이 항목을 저장하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de favorito destacado para salvar este artigo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите выделенную кнопку закладки, чтобы сохранить эту статью."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть виділену кнопку закладки, щоб зберегти цю статтю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击高亮显示的书签按钮以保存此文章。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊高亮顯示的書籤按鈕以儲存此文章。"
          }
        }
      }
    },
    "tutorial.step.bookmarks.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رائع! تمت إضافة المقالة إلى الإشارات المرجعية. يمكنك العثور على جميع إشاراتك المرجعية في تبويب الإشارات المرجعية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Super! Der Eintrag wurde als Lesezeichen gespeichert. Alle Ihre Lesezeichen finden Sie im Tab \"Lesezeichen\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Great! The article is now bookmarked. You can find all your bookmarks in the Bookmarks tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Genial! El artículo ha sido marcado. Puedes encontrar todos tus marcadores en la pestaña Marcadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Super ! L'article est maintenant en favori. Vous pouvez retrouver tous vos favoris dans l'onglet Favoris."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बढ़िया! लेख अब बुकमार्क हो गया है। आप अपने सभी बुकमार्क बुकमार्क टैब में पा सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すばらしい！記事がブックマークされました。すべてのブックマークは「ブックマーク」タブで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훌륭합니다! 항목이 북마크되었습니다. 모든 북마크는 북마크 탭에서 찾을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo! O artigo foi marcado como favorito. Você pode encontrar todos os seus favoritos na aba Favoritos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отлично! Статья добавлена в закладки. Все закладки можно найти на вкладке «Закладки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чудово! Стаття додана до закладок. Усі закладки можна знайти на вкладці «Закладки»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太棒了！文章已被收藏。您可以在「书签」标签页中找到所有收藏内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太棒了！文章已被收藏。您可以在「書籤」標籤頁中找到所有收藏內容。"
          }
        }
      }
    },
    "tutorial.step.dictionaryGroups.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتيح لك المجموعات تنظيم قواميسك حسب الموضوع أو اللغة — على سبيل المثال، \"الإسبانية\" أو \"القواعد\" أو \"الطب\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen ermöglichen es Ihnen, Ihre Wörterbücher nach Thema oder Sprache zu ordnen — zum Beispiel \"Spanisch\", \"Grammatik\" oder \"Medizin\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups let you organize your dictionaries by topic or language — for example, \"Spanish\", \"Grammar\", or \"Medical\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los grupos le permiten organizar sus diccionarios por tema o idioma — por ejemplo, \"Español\", \"Gramática\" o \"Médico\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes vous permettent d'organiser vos dictionnaires par sujet ou par langue — par exemple, \"Espagnol\", \"Grammaire\" ou \"Médecine\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह आपको अपने शब्दकोशों को विषय या भाषा के अनुसार व्यवस्थित करने देते हैं — जैसे \"स्पैनिश\", \"व्याकरण\", या \"चिकित्सा\"।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを使うと、辞書をテーマや言語で整理できます。たとえば「スペイン語」「文法」「医学」などです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 사용하면 주제나 언어별로 사전을 정리할 수 있습니다. 예를 들어 \"스페인어\", \"문법\" 또는 \"의학\" 등입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os grupos permitem organizar seus dicionários por tópico ou idioma — por exemplo, \"Espanhol\", \"Gramática\" ou \"Médico\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группы позволяют организовывать словари по теме или языку — например, «Испанский», «Грамматика» или «Медицина»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групи дозволяють організовувати словники за темою або мовою — наприклад, «Іспанська», «Граматика» або «Медицина»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分组让您可以按主题或语言整理词典——例如「西班牙语」、「语法」或「医学」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分組讓您可以按主題或語言整理詞典——例如「西班牙語」、「文法」或「醫學」。"
          }
        }
      }
    },
    "tutorial.step.dictionaryGroups.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي كل مجموعة على مجموعة فرعية من قواميسك. عند تحديد مجموعة، يتم استخدام قواميسها فقط لعمليات البحث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Gruppe enthält eine Teilmenge Ihrer Wörterbücher. Wenn Sie eine Gruppe auswählen, werden nur deren Wörterbücher für die Suche verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each group contains a subset of your dictionaries. When you select a group, only its dictionaries are used for lookups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada grupo contiene un subconjunto de sus diccionarios. Cuando selecciona un grupo, solo sus diccionarios se usan para las búsquedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque groupe contient un sous-ensemble de vos dictionnaires. Lorsque vous sélectionnez un groupe, seuls ses dictionnaires sont utilisés pour les recherches."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक समूह में आपके शब्दकोशों का एक उपसमूह होता है। जब आप कोई समूह चुनते हैं, तो केवल उस समूह के शब्दकोश खोज के लिए उपयोग किए जाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループには辞書の一部が含まれます。グループを選択すると、そのグループの辞書のみが検索に使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 그룹에는 사전의 일부가 포함됩니다. 그룹을 선택하면 해당 그룹의 사전만 검색에 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada grupo contém um subconjunto dos seus dicionários. Ao selecionar um grupo, apenas os dicionários dele são usados para pesquisas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая группа содержит подмножество ваших словарей. При выборе группы для поиска используются только её словари."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна група містить підмножину ваших словників. Коли ви вибираєте групу, для пошуку використовуються лише її словники."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个分组包含您词典的一个子集。当您选择某个分组时，仅该分组中的词典会用于查词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個分組包含您詞典的一個子集。當您選擇某個分組時，僅該分組中的詞典會用於查詞。"
          }
        }
      }
    },
    "tutorial.step.dictionaryGroups.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على \"إضافة مجموعة جديدة\" لإنشاء مجموعة. يمكنك بعد ذلك إضافة قواميس إليها من محرر المجموعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf \"Neue Gruppe hinzufügen\", um eine Gruppe zu erstellen. Anschließend können Sie Wörterbücher über den Gruppeneditor hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Add New Group\" to create a group. You can then add dictionaries to it from the group editor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque \"Agregar nuevo grupo\" para crear un grupo. Luego puede agregar diccionarios desde el editor de grupos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur \"Ajouter un nouveau groupe\" pour créer un groupe. Vous pouvez ensuite y ajouter des dictionnaires depuis l'éditeur de groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह बनाने के लिए \"नया समूह जोड़ें\" पर टैप करें। फिर आप समूह संपादक से उसमें शब्दकोश जोड़ सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「新しいグループを追加」をタップしてグループを作成します。グループエディタから辞書を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"새 그룹 추가\"를 탭하여 그룹을 만드세요. 그런 다음 그룹 편집기에서 사전을 추가할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em \"Adicionar novo grupo\" para criar um grupo. Você pode então adicionar dicionários a ele pelo editor de grupos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Добавить новую группу», чтобы создать группу. Затем вы можете добавить словари в неё через редактор группы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть «Додати нову групу», щоб створити групу. Потім ви можете додати словники до неї через редактор групи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「添加新分组」来创建一个分组，然后您可以通过分组编辑器向其中添加词典。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選「新增群組」來建立一個分組，然後您可以透過群組編輯器向其中新增詞典。"
          }
        }
      }
    },
    "tutorial.step.dictionaryGroups.step4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على زر التعديل للدخول إلى وضع التعديل، حيث يمكنك إدارة المجموعات وإعادة ترتيبها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die Schaltfläche Bearbeiten, um den Bearbeitungsmodus aufzurufen, in dem Sie Gruppen verwalten und neu anordnen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the Edit button to enter editing mode, where you can manage groups and reorder them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el botón Editar para entrar en el modo de edición, donde puede administrar grupos y reordenarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton Modifier pour entrer en mode édition, où vous pouvez gérer les groupes et les réorganiser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादन मोड में प्रवेश करने के लिए संपादित करें बटन पर टैप करें, जहाँ आप समूहों को प्रबंधित और पुनर्व्यवस्थित कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「編集」ボタンをタップして編集モードに入ると、グループの管理や並び替えができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 버튼을 탭하여 편집 모드로 진입하면 그룹을 관리하고 순서를 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão Editar para entrar no modo de edição, onde você pode gerenciar grupos e reordená-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку «Редактировать», чтобы войти в режим редактирования, где можно управлять группами и изменять их порядок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку «Редагувати», щоб увійти в режим редагування, де можна керувати групами та змінювати їх порядок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「编辑」按钮进入编辑模式，在那里您可以管理分组并重新排序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選「編輯」按鈕進入編輯模式，在那裡您可以管理分組並重新排序。"
          }
        }
      }
    },
    "tutorial.step.dictionaryGroups.step5": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الزر ℹ في \"Japanese\" لعرض إعدادات هذه المجموعة وتعديلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die Schaltfläche ℹ bei \"Japanese\", um die Einstellungen dieser Gruppe anzuzeigen und zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the ℹ button on \"Japanese\" to view and edit this group's settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el botón ℹ en \"Japanese\" para ver y editar la configuración de este grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton ℹ de \"Japanese\" pour afficher et modifier les paramètres de ce groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समूह की सेटिंग देखने और संपादित करने के लिए \"Japanese\" पर ℹ बटन टैप करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Japanese」の ℹ ボタンをタップして、このグループの設定を表示・編集します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Japanese\"의 ℹ 버튼을 탭하여 이 그룹의 설정을 보고 편집하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão ℹ em \"Japanese\" para visualizar e editar as configurações deste grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку ℹ на «Japanese», чтобы просмотреть и изменить настройки этой группы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку ℹ на «Japanese», щоб переглянути та відредагувати налаштування цієї групи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「Japanese」上的 ℹ 按钮，查看和编辑该分组的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選「Japanese」上的 ℹ 按鈕，查看和編輯該分組的設定。"
          }
        }
      }
    },
    "tutorial.step.dictionaryGroups.step6": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في شاشة المعلومات هذه، يمكنك عرض البيانات الوصفية والإحصاءات للمجموعة المحددة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Informationsbildschirm können Sie die Metadaten und Statistiken der ausgewählten Gruppe anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this info screen, you can view the selected group's metadata and statistics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta pantalla de información, puede ver los metadatos y las estadísticas del grupo seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet écran d'informations, vous pouvez consulter les métadonnées et les statistiques du groupe sélectionné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस जानकारी स्क्रीन पर, आप चयनित समूह के मेटाडेटा और आँकड़े देख सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この情報画面では、選択したグループのメタデータと統計を表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 정보 화면에서 선택한 그룹의 메타데이터와 통계를 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta tela de informações, você pode visualizar os metadados e as estatísticas do grupo selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом информационном экране вы можете просмотреть метаданные и статистику выбранной группы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому інформаційному екрані ви можете переглянути метадані та статистику вибраної групи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此信息页面，您可以查看所选分组的元数据和统计信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此資訊頁面，您可以查看所選分組的中繼資料和統計資訊。"
          }
        }
      }
    },
    "tutorial.step.dictionaryGroups.step7": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك أيضًا تخصيص اسم المجموعة بالضغط على زر التعديل وإدخال اسم المجموعة المطلوب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können den Gruppennamen auch anpassen, indem Sie auf die Schaltfläche Bearbeiten tippen und den gewünschten Gruppennamen eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also customize the group name by tapping the Edit button and input your desired group name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puede personalizar el nombre del grupo tocando el botón Editar e ingresando el nombre de grupo deseado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez également personnaliser le nom du groupe en appuyant sur le bouton Modifier et en saisissant le nom de groupe souhaité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप संपादित करें बटन टैप करके और अपना इच्छित समूह नाम दर्ज करके समूह का नाम भी अनुकूलित कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「編集」ボタンをタップして希望するグループ名を入力することで、グループ名をカスタマイズすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 버튼을 탭하고 원하는 그룹 이름을 입력하여 그룹 이름을 맞춤 설정할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode personalizar o nome do grupo tocando no botão Editar e inserindo o nome de grupo desejado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы также можете настроить название группы, нажав кнопку «Редактировать» и введя нужное название группы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви також можете налаштувати назву групи, натиснувши кнопку «Редагувати» та ввівши бажану назву групи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您也可以通过点击「编辑」按钮并输入所需的分组名称来自定义分组名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您也可以透過點選「編輯」按鈕並輸入所需的分組名稱來自訂分組名稱。"
          }
        }
      }
    },
    "tutorial.step.dictionaryGroups.step8": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإدارة قواميس هذه المجموعة، انقر زر العناصر المتضمّنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Wörterbücher dieser Gruppe zu verwalten, tippe auf die Schaltfläche für enthaltene Elemente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To manage the dictionaries of this group, please tap the contained items button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gestionar los diccionarios de este grupo, toca el botón de elementos contenidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour gérer les dictionnaires de ce groupe, appuyez sur le bouton des éléments contenus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समूह के शब्दकोशों को प्रबंधित करने के लिए, कृपया शामिल आइटम बटन दबाएं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループの辞書を管理するには、含まれるアイテムボタンをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹의 사전을 관리하려면 포함된 항목 버튼을 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gerenciar os dicionários deste grupo, toque no botão de itens contidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы управлять словарями этой группы, нажмите кнопку входящих элементов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб керувати словниками цієї групи, натисніть кнопку вмісту елементів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要管理此组中的词典，请点击包含项目按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要管理此群組中的詞典，請點按包含項目按鈕。"
          }
        }
      }
    },
    "tutorial.step.dictionaryGroups.step9": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محرر المجموعة يعرض القواميس في هذه المجموعة وغيرها المتاحة للإضافة. يمكنك السحب لإعادة الترتيب، أو استخدام ⊕/⊖ لإضافة الأعضاء أو إزالتهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gruppeneditor zeigt Wörterbücher in dieser Gruppe und andere, die hinzugefügt werden können. Du kannst sie per Drag-and-Drop neu anordnen oder ⊕/⊖ verwenden, um Mitglieder hinzuzufügen oder zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group editor shows dictionaries in this group and others available to add. You can drag to reorder, or use ⊕/⊖ to add or remove members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor de grupo muestra los diccionarios de este grupo y otros disponibles para añadir. Puedes arrastrar para reordenar, o usar ⊕/⊖ para agregar o quitar miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur de groupe affiche les dictionnaires de ce groupe et les autres disponibles à ajouter. Vous pouvez faire glisser pour réorganiser, ou utiliser ⊕/⊖ pour ajouter ou supprimer des membres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्रुप संपादक इस ग्रुप के शब्दकोश और जोड़ने योग्य अन्य शब्दकोश दिखाता है। आप क्रम बदलने के लिए खिंच सकते हैं, या सदस्य जोड़ने या हटाने के लिए ⊕/⊖ का उपयोग कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループエディタには、このグループ内の辞書と追加可能な他の辞書が表示されます。ドラッグして並び替えるか、⊕/⊖ を使ってメンバーを追加または削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹 편집기에는 이 그룹의 사전과 추가 가능한 다른 사전이 표시됩니다. 드래그하여 순서를 변경하거나 ⊕/⊖를 사용하여 구성원을 추가하거나 제거할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor de grupo mostra os dicionários deste grupo e outros disponíveis para adicionar. Você pode arrastar para reordenar, ou usar ⊕/⊖ para adicionar ou remover membros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор группы показывает словари этой группы и другие, доступные для добавления. Вы можете перетаскивать для изменения порядка или использовать ⊕/⊖ для добавления или удаления участников."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор групи показує словники цієї групи та інші, доступні для додавання. Ви можете перетягувати для зміни порядку або використовувати ⊕/⊖ для додавання чи видалення учасників."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组编辑器显示此组中的词典以及可添加的其他词典。您可以拖动以重新排序，或使用 ⊕/⊖ 来添加或移除成员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組編輯器顯示此群組中的詞典以及可新增的其他詞典。您可以拖移以重新排序，或使用 ⊕/⊖ 來新增或移除成員。"
          }
        }
      }
    },
    "tutorial.step.enhanceDarkMode.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك زر القمر تحسين قابلية القراءة في الوضع الداكن لكل قاموس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mond-Schaltfläche ermöglicht es Ihnen, die Lesbarkeit im Dunkelmodus für jedes Wörterbuch zu verbessern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moon button lets you enhance readability in dark mode for each dictionary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de luna te permite mejorar la legibilidad en el modo oscuro para cada diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton lune vous permet d'améliorer la lisibilité en mode sombre pour chaque dictionnaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चंद्रमा बटन आपको प्रत्येक शब्दकोश के लिए डार्क मोड में पठनीयता बेहतर बनाने देता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月ボタンを使うと、辞書ごとにダークモードでの読みやすさを向上させることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달 버튼을 사용하면 각 사전의 다크 모드 가독성을 향상시킬 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão de lua permite melhorar a legibilidade no modo escuro para cada dicionário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка с луной позволяет улучшить читаемость в тёмном режиме для каждого словаря."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка місяця дозволяє покращити читабельність у темному режимі для кожного словника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月亮按钮可让您为每部词典增强暗模式下的阅读体验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "月亮按鈕可讓您為每部詞典增強深色模式下的閱讀體驗。"
          }
        }
      }
    },
    "tutorial.step.enhanceDarkMode.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على زر القمر المميز لفتح لوحة الضبط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die hervorgehobene Mond-Schaltfläche, um das Anpassungsfenster zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the highlighted moon button to open the adjustment panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de luna resaltado para abrir el panel de ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton lune en surbrillance pour ouvrir le panneau de réglage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समायोजन पैनल खोलने के लिए हाइलाइट किए गए चंद्रमा बटन पर टैप करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライトされた月ボタンをタップして調整パネルを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 표시된 달 버튼을 탭하여 조정 패널을 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de lua destacado para abrir o painel de ajuste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите выделенную кнопку с луной, чтобы открыть панель настроек."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть виділену кнопку місяця, щоб відкрити панель налаштувань."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击高亮显示的月亮按钮以打开调节面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊高亮顯示的月亮按鈕以開啟調節面板。"
          }
        }
      }
    },
    "tutorial.step.enhanceDarkMode.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط شريط التمرير للعثور على السطوع المثالي. يمكن أن يكون لكل قاموس إعداده الخاص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie den Schieberegler ein, um die optimale Helligkeit zu finden. Jedes Wörterbuch kann seine eigene Einstellung haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the slider to find the perfect brightness. Each dictionary can have its own setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el control deslizante para encontrar el brillo perfecto. Cada diccionario puede tener su propia configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez le curseur pour trouver la luminosité idéale. Chaque dictionnaire peut avoir son propre réglage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आदर्श चमक खोजने के लिए स्लाइडर को समायोजित करें। प्रत्येक शब्दकोश की अपनी सेटिंग हो सकती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライダーを調整してちょうどいい明るさを見つけてください。辞書ごとに個別に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이더를 조정하여 최적의 밝기를 찾으세요. 각 사전마다 개별 설정을 가질 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o controle deslizante para encontrar o brilho perfeito. Cada dicionário pode ter sua própria configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте ползунок, чтобы найти идеальную яркость. Каждый словарь может иметь свои настройки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте повзунок, щоб знайти ідеальну яскравість. Кожен словник може мати власне налаштування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整滑块以找到最佳亮度。每部词典都可以有自己的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整滑桿以找到最佳亮度。每部詞典都可以有自己的設定。"
          }
        }
      }
    },
    "tutorial.step.findInPage.step1": {
      "extractionState": "manual",
      "localizations": {
