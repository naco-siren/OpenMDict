    "welcome.footer" : {
      "comment" : "Welcome screen footer paragraph",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict هو قارئ قواميس بتنسيق MDict (MDX). للحصول على محتوى أغنى، يمكنك استيراد ملفات .mdx الخاصة بك — راجع منظومة MDict المزدهرة ومجتمعاتها للحصول على الموارد ومواصفات التنسيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict ist ein Wörterbuch-Reader im MDict-Format (MDX). Für umfangreichere Inhalte können Sie eigene .mdx-Dateien importieren — nutzen Sie das vielfältige MDict-Ökosystem und seine Communities für Ressourcen und Formatspezifikationen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict is an MDict (MDX) format dictionary reader. For richer content, you can import your own .mdx files — refer to the thriving MDict ecosystem and its communities for resources and format specifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict es un lector de diccionarios en formato MDict (MDX). Para contenido más completo, puedes importar tus propios archivos .mdx — consulta el próspero ecosistema de MDict y sus comunidades para obtener recursos y especificaciones de formato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict est un lecteur de dictionnaires au format MDict (MDX). Pour un contenu plus riche, vous pouvez importer vos propres fichiers .mdx — consultez l’écosystème MDict et ses communautés pour les ressources et les spécifications de format."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict एक MDict (MDX) फ़ॉर्मैट शब्दकोश रीडर है। अधिक समृद्ध सामग्री के लिए, आप अपनी .mdx फ़ाइलें आयात कर सकते हैं — संसाधनों और फ़ॉर्मैट विशिष्ताओं के लिए MDict के समृद्ध इकोसिस्टम और उसके समुदायों को देखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDictはMDict (MDX) 形式の辞書リーダーです。より豊富なコンテンツを利用するには、独自の.mdxファイルを読み込むことができます — リソースやフォーマット仕様については、活発なMDictエコシステムとそのコミュニティを参照してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict는 MDict (MDX) 형식의 사전 리더입니다. 더 풍부한 콘텐츠를 위해 자신의 .mdx 파일을 가져올 수 있습니다 — 리소스 및 형식 사양에 대해서는 활발한 MDict 생태계와 커뮤니티를 참고하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict é um leitor de dicionários no formato MDict (MDX). Para conteúdo mais completo, você pode importar seus próprios arquivos .mdx — consulte o próspero ecossistema do MDict e suas comunidades para recursos e especificações de formato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict — это приложение для чтения словарей в формате MDict (MDX). Для более богатого контента вы можете импортировать свои собственные файлы .mdx — обратитесь к обширной экосистеме MDict и её сообществам за ресурсами и спецификациями формата."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict — це застосунок для читання словників у форматі MDict (MDX). Для більш насиченого контенту ви можете імпортувати власні файли .mdx — зверніться до розвиненої екосистеми MDict та її спільнот за ресурсами та специфікаціями формату."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict 是一款 MDict (MDX) 格式词典阅读器。如需更丰富的内容，你可以导入自己的 .mdx 文件—请参考繁荣的 MDict 生态系统及其社区获取资源和格式规范。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenMDict 是一款 MDict (MDX) 格式辭典閱讀器。如需更豐富的內容，你可以匯入自己的 .mdx 檔案—請參考繁榮的 MDict 生態系統及其社群取得資源和格式規範。"
          }
        }
      }
    },
