    "welcome.feature.multiWindow.body": {
      "comment": "Feature card body",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمتع بإنتاجية بمستوى سطح المكتب من خلال استخدام النوافذ المتعددة واختصارات لوحة المفاتيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genießen Sie Desktop-Produktivität durch die Nutzung mehrerer Fenster und Tastaturkurzbefehle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoy desktop-class productivity by utilizing multiple windows and keyboard shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de productividad de escritorio utilizando múltiples ventanas y atajos de teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez d’une productivité digne d’un ordinateur grâce au multifenêtrage et aux raccourcis clavier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई विंडो और कीबोर्ड शॉर्टकट का उपयोग करके डेस्कटॉप जैसी उत्पादकता का आनंद लें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のウインドウとキーボードショートカットを活用して、デスクトップ級の生産性を実現。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 창과 키보드 단축키를 활용하여 데스크톱급 생산성을 경험하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproveite produtividade de desktop utilizando múltiplas janelas e atalhos de teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наслаждайтесь продуктивностью настольного класса, используя несколько окон и сочетания клавиш."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Насолоджуйтесь продуктивністю настільного класу, використовуючи кілька вікон та комбінації клавіш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "利用多窗口和键盘快捷键，享受桌面级工作效率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "利用多視窗和鍵盤快捷鍵，享受桌面級工作效率。"
          }
        }
      }
    },
