          "stringUnit": {
            "state": "new",
            "value": "Loading dictionaries…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cargando diccionarios…"
          }
        },
        "fr": {
          "stringUnit": {
