          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사전 로드 중…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Carregando dicionários…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Загрузка словарей…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
