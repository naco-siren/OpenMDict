    "syncChooser.errorNotSignedIn": {
      "comment": "Sync chooser: error when iCloud account is not signed in",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من تسجيل الدخول إلى iCloud ومن تفعيل OpenMDict في إعدادات iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle sicher, dass du bei iCloud angemeldet bist und OpenMDict in den iCloud-Einstellungen aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure you are signed in to iCloud and that OpenMDict is enabled in iCloud settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de haber iniciado sesión en iCloud y de que OpenMDict esté activado en los ajustes de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous d'être connecté à iCloud et que OpenMDict est activé dans les réglages iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनिश्चित करें कि आप iCloud में साइन इन हैं और iCloud सेटिंग्स में OpenMDict सक्षम है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud にサインインしていること、および iCloud 設定で OpenMDict が有効になっていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인되어 있고 iCloud 설정에서 OpenMDict가 활성화되어 있는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que você está conectado ao iCloud e que o OpenMDict está ativado nos ajustes do iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что вы вошли в iCloud и OpenMDict включён в настройках iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переконайтеся, що ви увійшли в iCloud і OpenMDict увімкнено в налаштуваннях iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保已登录 iCloud，且在 iCloud 设置中已启用 OpenMDict。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確保已登入 iCloud，且在 iCloud 設定中已啟用 OpenMDict。"
          }
        }
      }
    },
