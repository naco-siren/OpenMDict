    "tutorial.enhanceDarkMode.desc": {
      "comment": "Tutorial level description",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصلاح قابلية قراءة الوضع الداكن في القواميس المستوردة ذات الأنماط المخصصة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelmodus-Lesbarkeit für importierte Wörterbücher mit eigenen Styles verbessern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix dark mode's readability on imported dictionaries with custom styles"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora la legibilidad del modo oscuro en diccionarios importados con estilos personalizados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliore la lisibilité du mode sombre pour les dictionnaires avec des styles personnalisés"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कस्टम स्टाइल वाले आयातित शब्दकोशों में डार्क मोड की पठनीयता ठीक करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムスタイルを持つ辞書のダークモードの読みやすさを修正"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 사전의 커스텀 스타일에서 다크 모드 가독성 수정"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija a legibilidade do modo escuro em dicionários importados com estilos personalizados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправить отображение тёмного режима для словарей с нестандартными стилями"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виправити відображення темного режиму для словників із нестандартними стилями"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修复导入词典自定义样式在深色模式下的可读性问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修復匯入詞典自訂樣式在深色模式下的可讀性問題"
          }
        }
      }
    },
