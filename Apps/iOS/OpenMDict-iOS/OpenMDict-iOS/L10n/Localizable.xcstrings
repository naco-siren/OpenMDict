    "aiCoach.flashcard.noCards": {
      "comment": "Flashcard: empty state — no bookmarks",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Bookmark some English words first, then come back to try AI Coach. It reviews up to 5 of your most recent bookmarks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず英単語をいくつかブックマークしてから、AI コーチを試してみてください。最近ブックマークした単語を最大5件まで復習できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 영어 단어를 북마크한 다음, 돌아와서 AI 코치를 사용해 보세요. 최근 북마크 최대 5개를 복습합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先收藏一些英文单词,再回来试用 AI 教练。它会从你最近收藏的最多 5 个单词中挑选复习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先收藏一些英文單字,再回來試用 AI Coach。系統會複習你最近收藏的最多 5 個單字。"
          }
        }
      }
    },
