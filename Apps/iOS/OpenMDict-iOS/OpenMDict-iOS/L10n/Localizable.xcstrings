    "wordList.articleScopeComingSoon.message": {
      "comment": "Body copy for the Article-scope coming-soon empty state",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your dictionaries are being indexed for article-content search. Once that's done, this scope will return matches by article body, not just by spelling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict 正在为您的词典建立词条内容索引。索引完成后,该查询模式将基于词条内容(而非仅拼写)返回结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMDict 正在為您的詞典建立詞條內容索引。索引完成後,該查詢模式將基於詞條內容(而非僅拼寫)返回結果。"
          }
        }
      }
    },
