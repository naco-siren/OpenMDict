            "value": "点击导航栏中的编辑按钮，以管理您已导入的词典。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按導覽列中的編輯按鈕，以管理您已匯入的詞典。"
          }
        }
      }
    },
    "tutorial.step.importAndResources.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر زر ℹ على WordNet لعرض معلومات القاموس وتحريرها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Schaltfläche ℹ bei WordNet, um die Wörterbuchinformationen anzuzeigen und zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the ℹ button on WordNet to view and edit its dictionary info."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
