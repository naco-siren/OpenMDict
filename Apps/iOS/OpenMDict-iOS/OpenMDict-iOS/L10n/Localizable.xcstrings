    "troubleshoot.resetFailed.message": {
      "comment": "Alert message: nuclear reset failed",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حذف البيانات السحابية. لم يتم تعديل بياناتك المحلية. يرجى التحقق من اتصالك بالشبكة والمحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Daten konnten nicht gelöscht werden. Ihre lokalen Daten wurden nicht verändert. Bitte überprüfen Sie Ihre Netzwerkverbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Could not delete cloud data. Your local data has not been modified. Please check your network connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron eliminar los datos en la nube. Sus datos locales no han sido modificados. Compruebe su conexión a Internet e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer les données cloud. Vos données locales n'ont pas été modifiées. Veuillez vérifier votre connexion réseau et réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड डेटा हटाया नहीं जा सका। आपका स्थानीय डेटा संशोधित नहीं किया गया है। कृपया अपना नेटवर्क कनेक्शन जाँचें और पुनः प्रयास करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドデータを削除できませんでした。ローカルデータは変更されていません。ネットワーク接続を確認してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 데이터를 삭제할 수 없습니다. 로컬 데이터는 변경되지 않았습니다. 네트워크 연결을 확인한 후 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível excluir os dados da nuvem. Seus dados locais não foram modificados. Verifique sua conexão de rede e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось удалить облачные данные. Локальные данные не были изменены. Проверьте подключение к сети и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося видалити хмарні дані. Локальні дані не були змінені. Перевірте підключення до мережі та спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除云端数据。本地数据未被修改。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除雲端資料。本機資料未被修改。請檢查網路連線後再試一次。"
          }
        }
      }
    },
